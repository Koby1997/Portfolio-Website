---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import Favicon from '../components/Favicon.astro';
import { ClientRouter } from 'astro:transitions';
import { SITE_DESCRIPTION } from '../data/site';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const { title, description = SITE_DESCRIPTION, image } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<Favicon />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<SeoHead title={title} description={description} image={image} />
		<ClientRouter fallback="swap" />
	</head>
	<body class="bg-zinc-950 text-zinc-50 min-h-screen flex flex-col font-sans antialiased overflow-x-hidden">
		<main class="flex-grow w-full">
			<slot />
		</main>
	</body>
</html>
