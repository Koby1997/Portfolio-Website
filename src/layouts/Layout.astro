---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import { ClientRouter } from 'astro:transitions';
import { SITE_DESCRIPTION } from '../data/site';

interface Props {
	title: string;
	description?: string;
	image?: string;
	hideNavAndFooter?: boolean;
}

const { title, description = SITE_DESCRIPTION, image, hideNavAndFooter = false } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<SeoHead title={title} description={description} image={image} />
		<ClientRouter fallback="swap" />
	</head>
	<body class="bg-zinc-950 text-zinc-50 min-h-screen flex flex-col font-sans antialiased overflow-x-hidden">
		{!hideNavAndFooter && <Navigation />}
		<main class={hideNavAndFooter ? "flex-grow w-full" : "flex-grow w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10"}>
			<slot />
		</main>
		{!hideNavAndFooter && <Footer />}
	</body>
</html>
