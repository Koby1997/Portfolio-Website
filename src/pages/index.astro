                            <a href="/timeline" id="unified-timeline-trigger" transition:name="timeline-page-link" class="group relative px-8 py-4 border border-zinc-700/50 hover:border-purple-500/50 bg-zinc-900/20 hover:bg-zinc-900/80 backdrop-blur-md rounded-xl transition-all duration-300 shadow-xl overflow-hidden text-center z-20">
                                <div class="absolute inset-0 bg-gradient-to-br from-purple-500/0 via-purple-500/0 to-purple-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                                <h3 class="relative z-10 text-sm md:text-base font-bold text-zinc-300 group-hover:text-white uppercase tracking-[0.2em] transition-colors">My Journey</h3>
                            </a>
                        </div>
                    </div>
                </div>

                

                </div>
        </div>
    </main>

    <style>
        .CustomScrollContainer::-webkit-scrollbar { height: 12px; }
        .CustomScrollContainer::-webkit-scrollbar-track { background: #09090b; }
        .CustomScrollContainer::-webkit-scrollbar-thumb { background: #27272a; border-radius: 8px; }
        .CustomScrollContainer::-webkit-scrollbar-thumb:hover { background: #3f3f46; }
    </style>

        <script>
        document.addEventListener('astro:page-load', () => {
            
            // --- Home Screen Image Cycler Logic ---
            let currentImg = document.getElementById('home-cycler-img-1');
            let nextImg = document.getElementById('home-cycler-img-2');
            
            if (currentImg && nextImg) {
                const homeImages = ['1.jpg', '2.jpg', '3.jpg', '4.jpg', '5.jpg', '6.jpg', '7.jpg', '8.jpg', '9.jpg', '10.jpg', '11.jpg', '12.jpg', '13.jpg', '14.jpg'];
                // Fisher-Yates Shuffle
                for (let i = homeImages.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    [homeImages[i], homeImages[j]] = [homeImages[j], homeImages[i]];
                }
                let currentCyclerIndex = 0;
                currentImg.src = '/assets/projects/home-page/' + homeImages[currentCyclerIndex];
                
                setInterval(() => {
                    const nextIndex = (currentCyclerIndex + 1) % homeImages.length;
                    
                    nextImg.onload = () => {
                        nextImg.style.zIndex = '10';
                        currentImg.style.zIndex = '0';
                        
                        nextImg.style.opacity = '1';
                        currentImg.style.opacity = '0';
                        
                        setTimeout(() => {
                            currentCyclerIndex = nextIndex;
                            let temp = currentImg;
                            currentImg = nextImg;
                            nextImg = temp;
                        }, 1500); 
                    };
                    
                    nextImg.src = '/assets/projects/home-page/' + homeImages[nextIndex];
                    if (nextImg.complete) {
                        nextImg.onload();
                    }
                }, 8000); 
            }

            // Cinematic Brain Zoom Logic
            const brainTrigger = document.getElementById('brain-link-trigger');
            if (brainTrigger) {
                brainTrigger.addEventListener('click', (e) => {
                    e.preventDefault();
                    
                    const targetO = document.getElementById('zoom-target-o');
                    const textContainer = document.getElementById('cinematic-koby-text');
                    const kobyOnly = document.getElementById('cinematic-koby-only');
                    const blackout = document.getElementById('blackout-overlay');
                    
                    if (targetO && textContainer && blackout && kobyOnly) {
                        sessionStorage.setItem('from_brain', 'true');

                        const oRect = targetO.getBoundingClientRect();
                        const kobyRect = kobyOnly.getBoundingClientRect();
                        const visualCenterY = oRect.height * 0.65; 
                        const visualCenterX = (oRect.width / 2) + 4; 

                        const originX = oRect.left - kobyRect.left + visualCenterX;
                        const originY = oRect.top - kobyRect.top + visualCenterY;
                        
                        const windowCenterX = window.innerWidth / 2;
                        const windowCenterY = window.innerHeight / 2;
                        const oScreenX = oRect.left + (oRect.width / 2);
                        const oScreenY = oRect.top + visualCenterY;
                        
                        const moveX = windowCenterX - oScreenX;
                        const moveY = windowCenterY - oScreenY;
                        
                        const heroSection = document.getElementById('unified-home-screen');
                        if (heroSection) heroSection.style.zIndex = '10000';
                        
                        kobyOnly.style.transformOrigin = `${originX}px ${originY}px`;
                        kobyOnly.style.willChange = 'transform';
                        kobyOnly.style.backfaceVisibility = 'hidden';
                        kobyOnly.style.position = 'relative';
                        kobyOnly.style.zIndex = '9999';
                        textContainer.style.zIndex = '9999';

                        requestAnimationFrame(() => {
                            document.querySelectorAll('a, p, nav, .cinematic-extra-text, #home-media-elements').forEach(el => {
                                if (el.style) {
                                    el.style.transition = 'opacity 0.8s ease';
                                    el.style.opacity = '0';
                                }
                            });
                            
                            blackout.style.transition = 'opacity 0.8s ease';
                            blackout.style.opacity = '1';
                            
                            kobyOnly.style.transition = 'transform 0.8s ease-in-out';
                            kobyOnly.style.transform = `translate3d(${moveX}px, ${moveY}px, 0)`;
                            
                            setTimeout(() => {
                                kobyOnly.style.transition = 'transform 2.0s cubic-bezier(0.8, 0, 1, 1)';
                                kobyOnly.style.transform = `translate3d(${moveX}px, ${moveY}px, 0) scale(100)`;

                                setTimeout(() => {
                                    if (heroSection) heroSection.style.zIndex = '';
                                    const link = document.createElement('a');
                                    link.href = '/brain';
                                    document.body.appendChild(link);
                                    link.click();
                                }, 1900);
                            }, 1100);
                        });
                    } else {
                        const link = document.createElement('a');
                        link.href = '/brain';
                        document.body.appendChild(link);
                        link.click();
                    }
                });
            }

            // Reverse Animation logic when returning from /brain
            const fromBrain = sessionStorage.getItem('from_brain');
            const targetO = document.getElementById('zoom-target-o');
            const textContainer = document.getElementById('cinematic-koby-text');
            const kobyOnly = document.getElementById('cinematic-koby-only');
            const blackout = document.getElementById('blackout-overlay');
            const otherElements = document.querySelectorAll('a, p, nav, .cinematic-extra-text, #home-media-elements');
            
            if (fromBrain) {
                sessionStorage.removeItem('from_brain');
                
                if (blackout) {
                    blackout.style.transition = 'none';
                    blackout.style.opacity = '1';
                    void blackout.offsetHeight;
                }
                
                if (targetO && textContainer && blackout && kobyOnly) {
                    textContainer.style.transform = 'none';
                    textContainer.style.transformOrigin = 'unset';
                    
                    kobyOnly.style.transition = 'none';
                    kobyOnly.style.transform = 'none';
                    kobyOnly.style.transformOrigin = 'unset';
                    
                    void textContainer.offsetHeight;
                    void kobyOnly.offsetHeight;
                    
                    const oRect = targetO.getBoundingClientRect();
                    const kobyRect = kobyOnly.getBoundingClientRect();
                    const heroSection = document.getElementById('unified-home-screen');
                    
                    if (heroSection) {
                        heroSection.style.zIndex = '10000';
                    }
                    
                    const visualCenterY = oRect.height * 0.65;
                    const visualCenterX = (oRect.width / 2) + 4; 
                    const originX = oRect.left - kobyRect.left + visualCenterX;
                    const originY = oRect.top - kobyRect.top + visualCenterY;
                    
                    const windowCenterX = window.innerWidth / 2;
                    const windowCenterY = window.innerHeight / 2;
                    const oScreenX = oRect.left + visualCenterX;
                    const oScreenY = oRect.top + visualCenterY;
                    const moveX = windowCenterX - oScreenX;
                    const moveY = windowCenterY - oScreenY;
                    
                    kobyOnly.style.transformOrigin = `${originX}px ${originY}px`;
                    kobyOnly.style.transform = `translate3d(${moveX}px, ${moveY}px, 0) scale(100)`;
                    kobyOnly.style.position = 'relative';
                    kobyOnly.style.zIndex = '9999';
                    textContainer.style.zIndex = '9999';
                    
                    otherElements.forEach(el => {
                        if (el.style) {
                            el.style.opacity = '0';
                        }
                    });
                    
                    requestAnimationFrame(() => {
                        kobyOnly.style.transition = 'transform 2.5s cubic-bezier(0.1, 1, 0.2, 1)';
                        kobyOnly.style.transform = 'translate3d(0, 0, 0) scale(1)';
                        
                        setTimeout(() => {
                            setTimeout(() => {
                                if (blackout) {
                                    blackout.style.transition = 'opacity 1s ease-in-out';
                                    blackout.style.opacity = '0';
                                }
                                otherElements.forEach(el => {
                                    if (el.style) {
                                        el.style.transition = 'opacity 1s ease';
                                        el.style.opacity = '1';
                                    }
                                });
                            }, 800); 
                        }, 2500); 
                        
                        setTimeout(() => {
                            if (kobyOnly) {
                                kobyOnly.style.transform = '';
                                kobyOnly.style.transformOrigin = '';
                                kobyOnly.style.transition = '';
                                kobyOnly.style.position = '';
                                kobyOnly.style.zIndex = '';
                                kobyOnly.style.opacity = '';
                            }
                            if (textContainer) {
                                textContainer.style.zIndex = '';
                            }
                            if (blackout) {
                                blackout.style.transition = '';
                                blackout.style.zIndex = '';
                            }
                            if (heroSection) {
                                heroSection.style.zIndex = '';
                            }
                            otherElements.forEach(el => {
                                if (el.style) {
                                    el.style.transition = '';
                                    el.style.opacity = '';
                                }
                            });
                        }, 4500);
                    });
                }
            } else {
                if (textContainer) {
                    textContainer.style.transition = 'none';
                    textContainer.style.transform = 'none';
                    textContainer.style.transformOrigin = 'unset';
                    textContainer.style.zIndex = '';
                    
                    textContainer.style.filter = 'blur(0.1px)';
                    textContainer.style.textShadow = '0 0 1px rgba(0,0,0,0.01)';
                    setTimeout(() => {
                        if(textContainer) {
                            textContainer.style.filter = '';
                            textContainer.style.textShadow = '';
                        }
                    }, 50);
                    
                    requestAnimationFrame(() => textContainer.style.transition = '');
                }
                if (blackout) {
                    blackout.style.transition = 'none';
                    blackout.style.opacity = '0';
                    requestAnimationFrame(() => blackout.style.transition = '');
                }
                otherElements.forEach(el => {
                    if (el.style) {
                        el.style.transition = 'none';
                        el.style.opacity = '';
                        requestAnimationFrame(() => el.style.transition = '');
                    }
                });
            }

            // Canvas Parallax Hues Renderer (Phase 2)
            if (!window.parallaxCanvasInitialized) {
                window.parallaxCanvasInitialized = true;
                const canvas = document.getElementById('parallax-canvas');
                if (canvas) {
                    const ctx = canvas.getContext('2d', { alpha: true });
                    let hues = [];
                    try {
                        hues = JSON.parse(document.getElementById('hue-data').textContent);
                    } catch(e) {}
                    
                    const resizeCanvas = () => {
                        canvas.width = window.innerWidth;
                        canvas.height = window.innerHeight;
                    };
                    window.addEventListener('resize', resizeCanvas);
                    resizeCanvas();

                    let lastRenderedScroll = -1;
                    const renderCanvas = () => {
                        requestAnimationFrame(renderCanvas);
                        
                        const container = document.querySelector('.CustomScrollContainer');
                        let currentScroll = container ? container.scrollLeft : 0;
                        
                        const parallaxOffset = currentScroll ? (currentScroll * 0.08) : 0;
                        
                        if (Math.abs(lastRenderedScroll - parallaxOffset) < 0.5 && canvas.width === window.innerWidth) return;
                        lastRenderedScroll = parallaxOffset;

                        ctx.clearRect(0, 0, canvas.width, canvas.height);
                        
                        const vw = window.innerWidth / 100;
                        const vh = window.innerHeight / 100;
                        
                        for (let i = 0; i < hues.length; i++) {
                            const h = hues[i];
                            const cx = (h.left * vw) - parallaxOffset;
                            const cy = h.top * vh;
                            
                            const sizePx = Math.max(320, Math.min(h.size * vw, 1280)); 
                            const radius = sizePx / 2;
                            
                            if (cx + radius < 0 || cx - radius > canvas.width) continue;
                            
                            const gradient = ctx.createRadialGradient(cx, cy, 0, cx, cy, radius);
                            gradient.addColorStop(0, 'rgba(168, 85, 247, 0.15)');
                            gradient.addColorStop(0.5, 'rgba(168, 85, 247, 0.05)');
                            gradient.addColorStop(1, 'rgba(168, 85, 247, 0)');
                            
                            ctx.fillStyle = gradient;
                            ctx.beginPath();
                            ctx.arc(cx, cy, radius, 0, Math.PI * 2);
                            ctx.fill();
                        }
                    };
                    requestAnimationFrame(renderCanvas);
                }
            }

        });
    </script>
    <style>
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</body>
</html>