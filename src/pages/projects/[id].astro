---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { getColorConfig } from '../../data/categories';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const primaryCategory = project.data.categories[0] || 'Unknown';

const displayImage = project.data.heroImage || project.data.coverImage;
---
<Layout
  title={`${project.data.title} | Koby L.`}
  description={project.data.description}
  image={displayImage}
  hideNavAndFooter={true}
>
  <div class="w-full bg-zinc-950 text-white min-h-[100dvh]">

    <!-- Tailwind JIT Safelist explicitly for injected markdown grids -->
    <div class="hidden md:col-span-3 md:col-span-4 md:col-span-5 md:col-span-6 md:col-span-7 md:col-span-8 md:col-span-9 md:col-span-12 gap-16 gap-12 grid-cols-1 md:grid-cols-12 max-h-[600px] max-h-[500px] max-h-[400px] max-w-[400px] items-start items-center"></div>

    <!-- Floating Back Button -->
    <a href="/" id="dynamic-back-button" class="group fixed top-8 left-8 flex items-center justify-center w-auto px-5 h-12 bg-black/50 backdrop-blur-md border border-white/10 rounded-full hover:bg-black/80 hover:-translate-x-1 transition-all shadow-xl z-50 cursor-pointer gap-2.5">
        <svg class="w-4 h-4 transition-transform duration-300 group-hover:-translate-x-1.5 text-purple-400 group-hover:text-purple-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        <span id="dynamic-back-text" class="text-zinc-300 group-hover:text-white font-sans text-xs font-medium tracking-widest uppercase mt-[1px]">Back to Timeline</span>
    </a>

    <!-- Massive Hero - Edge to Edge with Magic Zoom Tie -->
    <div
        transition:name={`project-box-${project.id}`}
        data-hero
        class="w-full h-[60vh] md:h-[80vh] relative overflow-hidden bg-zinc-900"
    >
        {displayImage ? (
            project.data.heroFit === 'contain' ? (
                <>
                    {/\.(mp4|webm|mov)$/i.test(displayImage) ? (
                        <>
                            <video src={displayImage} autoplay loop muted playsinline class="absolute inset-0 w-full h-full object-cover z-0 opacity-40 blur-3xl scale-110"></video>
                            <video src={displayImage} autoplay loop muted playsinline class="w-full h-full object-contain z-10 relative drop-shadow-2xl"></video>
                        </>
                    ) : (
                        <>
                            <img src={displayImage} alt="" class="absolute inset-0 w-full h-full object-cover z-0 opacity-40 blur-3xl scale-110" />
                            <img src={displayImage} alt={project.data.title} class="w-full h-full object-contain z-10 relative drop-shadow-2xl" />
                        </>
                    )}
                </>
            ) : (
                /\.(mp4|webm|mov)$/i.test(displayImage) ? (
                    <video
                        src={displayImage}
                        autoplay loop muted playsinline
                        class="absolute inset-0 w-full h-full object-cover z-0"
                    ></video>
                ) : (
                    <img
                        src={displayImage}
                        alt={project.data.title}
                        class="absolute inset-0 w-full h-full object-cover z-0"
                    />
                )
            )
        ) : (
            <div class="w-full h-full bg-zinc-900 flex items-center justify-center font-mono text-zinc-600 text-3xl">
                [ {primaryCategory.toUpperCase()} HERO ]
            </div>
        )}

        <div class="absolute inset-0 flex flex-col justify-end p-8 md:p-16">
            <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/40 to-transparent z-10 h-full pointer-events-none"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-zinc-950 via-zinc-950/20 to-transparent z-10 w-[80vw] pointer-events-none"></div>

            <div class="relative z-20 max-w-4xl pt-24">
                <div class="flex flex-wrap gap-2 mb-6">
                    {project.data.categories.map((cat) => {
                        const subColors = getColorConfig(cat);
                        return <span class={`px-4 py-1.5 ${subColors.badgeBg} border border-current/20 ${subColors.badgeText} text-[10px] font-bold tracking-widest uppercase rounded backdrop-blur-sm`}>{cat}</span>
                    })}
                </div>

                <h1 class="text-4xl md:text-8xl xl:text-[10rem] font-black tracking-tighter mb-4 text-white leading-tight md:leading-[0.9] drop-shadow-2xl inline-block whitespace-normal md:whitespace-nowrap">
                    {project.data.title}
                </h1>

                <p class="text-xl md:text-2xl text-zinc-300 drop-shadow-xl font-light mt-4 max-w-2xl leading-relaxed">
                    {project.data.description}
                </p>
            </div>
        </div>
    </div>

    <!-- CONTENT PAYLOAD -->
    <div class="w-full">
        <Content />
    </div>

  </div>

    <!-- Lightbox Overlay -->
    <div id="lightbox-overlay" class="fixed inset-0 z-[100] bg-black/95 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300 flex items-center justify-center p-4 md:p-12">
        <button id="lightbox-close" class="absolute top-8 right-8 text-white/50 hover:text-white z-50 p-4 cursor-pointer">
            <svg class="w-10 h-10 drop-shadow-lg" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
        <div id="lightbox-content" class="relative w-full h-full flex items-center justify-center max-w-7xl mx-auto transform scale-95 transition-transform duration-300">
        </div>
    </div>

<script>
    import { observeLazyMedia } from '../../scripts/lazyMedia';

    // Hero videos load eagerly; make sure they're playing after a view transition swap.
    const playHeroVideos = () => {
        document.querySelectorAll<HTMLVideoElement>('[data-hero] video').forEach(video => {
            video.play().catch(() => {
                video.load();
                video.play().catch(() => {});
            });
        });
    };

    let pageController: AbortController | null = null;
    let mediaObserver: IntersectionObserver | null = null;

    document.addEventListener('astro:page-load', () => {
        // Tear down listeners from the previous visit to this page
        pageController?.abort();
        mediaObserver?.disconnect();

        const overlay = document.getElementById('lightbox-overlay');
        const contentContainer = document.getElementById('lightbox-content');
        const closeBtn = document.getElementById('lightbox-close');

        if (!overlay || !contentContainer || !closeBtn) return;

        pageController = new AbortController();
        const { signal } = pageController;

        playHeroVideos();
        // Content media loads/plays only when within ~1 screen of the viewport
        mediaObserver = observeLazyMedia(null, '100% 0px 100% 0px');

        const mediaElements = document.querySelectorAll<HTMLImageElement | HTMLVideoElement>('img, video');

        const closeLightbox = () => {
            overlay.classList.remove('opacity-100', 'pointer-events-auto');
            overlay.classList.add('opacity-0', 'pointer-events-none');
            contentContainer.classList.remove('scale-100');
            contentContainer.classList.add('scale-95');
            setTimeout(() => {
                contentContainer.innerHTML = '';
            }, 300);
        };

        overlay.addEventListener('click', (e) => {
            if (e.target === overlay || e.target === contentContainer) {
                closeLightbox();
            }
        });
        closeBtn.addEventListener('click', closeLightbox);
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeLightbox();
        }, { signal });

        mediaElements.forEach(el => {
            if (el.closest('a')) return;
            if (el.closest('[data-hero]')) return;

            el.classList.add('cursor-zoom-in');

            el.addEventListener('click', () => {
                const isVideo = el.tagName.toLowerCase() === 'video';
                const src = el.currentSrc || el.getAttribute('src') || el.dataset.src || '';

                contentContainer.innerHTML = '';

                if (isVideo) {
                    const vid = document.createElement('video');
                    vid.src = src;
                    vid.controls = true;
                    vid.autoplay = true;
                    vid.className = 'max-w-full max-h-[90vh] rounded-2xl shadow-2xl object-contain border border-zinc-800';
                    contentContainer.appendChild(vid);
                } else {
                    const img = document.createElement('img');
                    img.src = src;
                    img.className = 'max-w-full max-h-[90vh] rounded-2xl shadow-2xl object-contain border border-zinc-800';
                    contentContainer.appendChild(img);
                }

                overlay.classList.remove('opacity-0', 'pointer-events-none');
                overlay.classList.add('opacity-100', 'pointer-events-auto');
                contentContainer.classList.remove('scale-95');
                contentContainer.classList.add('scale-100');
            });
        });


        // Context-Aware Back Routing
        const params = new URLSearchParams(window.location.search);
        if (params.get('ref') === 'resume') {
            const backText = document.getElementById('dynamic-back-text');
            if (backText) backText.innerText = 'Back to Resume';
        }

    });
    document.addEventListener('astro:after-swap', playHeroVideos);
</script>
</Layout>
