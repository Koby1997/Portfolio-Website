---
import "../styles/global.css";

// Complete logic separation achieved! All underlying Brain mapping logic runs directly
// from your private physical module pipeline, cleanly decoupled from the actual Graphics Render code here!
import { hubs } from "../data/neuralNetwork.js";
import { ClientRouter } from "astro:transitions";
---

<html lang="en" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Neural Interface | Koby L.</title>
        <script type="importmap">
            {
                "imports": {
                    "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
                    "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
                }
            }
        </script>
        <ClientRouter fallback="swap" />
    </head>
    <body
        class="bg-[#050505] text-white m-0 p-0 font-sans w-screen h-screen overflow-hidden select-none"
    >
        <!-- Cinematic Entrance Overlay -->
        <div
            id="brain-entrance-overlay"
            class="fixed inset-0 bg-black z-[100] pointer-events-none transition-opacity duration-1000 opacity-100"
        >
        </div>

        <!-- Onboarding Controls Overlay -->
        <div
            id="onboarding-controls"
            class="fixed top-12 left-1/2 -translate-x-1/2 pointer-events-none z-[60] transition-opacity duration-1000 opacity-0 flex flex-col items-center"
        >
            <div
                class="relative w-[300px] h-[60px] flex justify-center items-center"
            >
                <!-- Step 1: Rotate -->
                <div
                    id="tutorial-step-1"
                    class="absolute flex items-center gap-4 text-white/80 drop-shadow-[0_2px_10px_rgba(0,0,0,0.8)] transition-all duration-700 ease-in-out transform translate-y-4 opacity-100"
                >
                    <svg
                        class="w-6 h-6 text-white hidden md:block"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.5"
                            d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"
                        ></path>
                    </svg>
                    <svg
                        class="w-6 h-6 text-white md:hidden block"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.5"
                            d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                    <span
                        class="text-lg md:text-xl font-light tracking-wide whitespace-nowrap hidden md:inline"
                        >Click and Drag to rotate</span
                    >
                    <span
                        class="text-lg md:text-xl font-light tracking-wide whitespace-nowrap inline md:hidden"
                        >Swipe to rotate</span
                    >
                </div>

                <!-- Step 2: Zoom -->
                <div
                    id="tutorial-step-2"
                    class="absolute flex items-center gap-4 text-white/80 drop-shadow-[0_2px_10px_rgba(0,0,0,0.8)] transition-all duration-700 ease-in-out transform translate-y-4 opacity-0 pointer-events-none"
                >
                    <svg
                        class="w-6 h-6 text-white hidden md:block"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.5"
                            d="M8 9l4-4 4 4m0 6l-4 4-4-4"></path>
                    </svg>
                    <svg
                        class="w-6 h-6 text-white md:hidden block"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.5"
                            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"
                        ></path>
                    </svg>
                    <span
                        class="text-lg md:text-xl font-light tracking-wide whitespace-nowrap hidden md:inline"
                        >Scroll to zoom</span
                    >
                    <span
                        class="text-lg md:text-xl font-light tracking-wide whitespace-nowrap inline md:hidden"
                        >Pinch to zoom</span
                    >
                </div>

                <!-- Step 3: Click -->
                <div
                    id="tutorial-step-3"
                    class="absolute flex items-center gap-4 text-white/80 drop-shadow-[0_2px_10px_rgba(0,0,0,0.8)] transition-all duration-700 ease-in-out transform translate-y-4 opacity-0 pointer-events-none"
                >
                    <svg
                        class="w-6 h-6 text-white hidden md:block"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        ><circle cx="12" cy="12" r="6"></circle>
                    </svg>
                    <svg
                        class="w-6 h-6 text-white md:hidden block"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <circle cx="12" cy="12" r="6"></circle>
                    </svg>
                    <span
                        class="text-lg md:text-xl font-light tracking-wide whitespace-nowrap hidden md:inline"
                        >Click on nodes to focus</span
                    >
                    <span
                        class="text-lg md:text-xl font-light tracking-wide whitespace-nowrap inline md:hidden"
                        >Tap nodes to focus</span
                    >
                </div>

                <!-- Step 4: Reset Focus -->
                <div
                    id="tutorial-step-4"
                    class="absolute flex items-center gap-4 text-white/80 drop-shadow-[0_2px_10px_rgba(0,0,0,0.8)] transition-all duration-700 ease-in-out transform translate-y-4 opacity-0 pointer-events-none"
                >
                    <svg
                        class="w-6 h-6 text-white hidden md:block"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.5"
                            d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                    <svg
                        class="w-6 h-6 text-white md:hidden block"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.5"
                            d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                    <span
                        class="text-lg md:text-xl font-light tracking-wide whitespace-nowrap hidden md:inline"
                        >Click empty space to reset focus</span
                    >
                    <span
                        class="text-lg md:text-xl font-light tracking-wide whitespace-nowrap inline md:hidden"
                        >Tap empty space to reset focus</span
                    >
                </div>
            </div>

            <!-- Skip Button -->
            <button
                id="skip-tutorial-btn"
                class="mt-4 text-zinc-500 hover:text-white text-sm font-medium tracking-widest uppercase transition-colors duration-300 pointer-events-auto"
            >
                Skip
            </button>
        </div>

        <!-- Navigation Interface -->
        <div class="fixed top-8 left-8 z-50 pointer-events-auto flex gap-4">
            <a
                id="exit-btn"
                href="/"
                data-astro-reload
                class="flex items-center gap-3 px-6 py-2.5 bg-zinc-950/40 backdrop-blur-md border border-white/10 rounded-full text-white/70 hover:text-white hover:bg-zinc-900/60 hover:border-white/30 transition-all duration-300 shadow-xl shadow-black/20 group"
            >
                <svg
                    class="w-4 h-4 transition-transform duration-300 group-hover:-translate-x-1.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg
                >
                <span
                    class="font-sans text-sm font-medium tracking-widest uppercase"
                    >Exit</span
                >
            </a>

            <!-- Start Tutorial Button -->
            <button
                id="restart-tutorial-btn"
                style="display: none;"
                class="flex items-center gap-2 px-4 py-2.5 bg-zinc-950/40 backdrop-blur-md border border-white/10 rounded-full text-zinc-500 hover:text-white hover:bg-zinc-900/60 hover:border-white/30 transition-all duration-300 shadow-xl shadow-black/20"
                title="Restart Tutorial"
            >
                <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    ></path></svg
                >
                <span
                    class="font-sans text-xs font-medium tracking-widest uppercase"
                    >Help</span
                >
            </button>
        </div>

        <!-- Focus Mode Close Button -->
        <button
            id="focus-close-btn"
            style="opacity: 0; pointer-events: none;"
            class="fixed top-8 right-8 z-50 hidden md:flex items-center gap-2 px-5 py-2.5 bg-zinc-950/40 backdrop-blur-md border border-white/10 rounded-full text-white/70 hover:text-white hover:bg-zinc-900/60 hover:border-white/30 transition-all duration-300 shadow-xl shadow-black/20 group cursor-pointer"
            title="Reset Focus"
        >
            <span
                class="font-sans text-xs font-medium tracking-widest uppercase"
                >Reset Focus</span
            >
            <svg
                class="w-4 h-4 transition-transform duration-300 group-hover:rotate-90"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>

        <!-- The 3D Render Target -->
        <div
            id="webgl-container"
            class="fixed inset-0 w-full h-full z-0 pointer-events-auto outline-none cursor-grab active:cursor-grabbing bg-[radial-gradient(ellipse_at_center,#050505_0%,#000_100%)]"
        >
        </div>

        <!-- Flat UI Canvas Overlay -->
        <div
            id="labels-container"
            class="fixed inset-0 w-full h-full z-10 pointer-events-none overflow-hidden"
        >
        </div>

        <!-- Premium Physics Tuner Panel -->
        <div
            id="control-panel"
            class="fixed bottom-8 left-8 z-50 pointer-events-auto bg-zinc-950/60 backdrop-blur-md border border-white/10 p-6 rounded-2xl shadow-2xl font-sans text-sm w-[360px] text-white/90 select-none hidden md:block transition-all duration-500 hover:bg-zinc-950/80 hover:border-white/20 group"
        >
            <!-- Header -->
            <div class="mb-6 flex items-center justify-between">
                <div
                    class="font-bold tracking-widest uppercase text-transparent bg-clip-text bg-gradient-to-r from-white to-zinc-400"
                >
                    Mess with my brain
                </div>
            </div>

            <div class="space-y-6">
                <!-- Node Density -->
                <div>
                    <div class="flex justify-between items-end mb-2">
                        <span class="font-medium tracking-wide text-zinc-200"
                            ># of Braincells</span
                        >
                        <span
                            id="label-density"
                            class="text-[11px] font-mono text-blue-400/90 text-right uppercase tracking-wider"
                        ></span>
                    </div>
                    <input
                        type="range"
                        id="slider-density"
                        min="0"
                        max="1000"
                        value="0"
                        class="w-full h-1.5 bg-zinc-800 rounded-lg appearance-none cursor-pointer accent-blue-500 hover:accent-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-500/50 transition-all"
                    />
                </div>

                <!-- Path Connections -->
                <div>
                    <div class="flex justify-between items-end mb-2">
                        <span class="font-medium tracking-wide text-zinc-200"
                            >Trains of Thought</span
                        >
                        <span
                            id="label-connections"
                            class="text-[11px] font-mono text-orange-400/90 text-right uppercase tracking-wider"
                        ></span>
                    </div>
                    <input
                        type="range"
                        id="slider-connections"
                        min="0"
                        max="250"
                        value="0"
                        class="w-full h-1.5 bg-zinc-800 rounded-lg appearance-none cursor-pointer accent-orange-500 hover:accent-orange-400 focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all"
                    />
                </div>
            </div>
        </div>

        <script define:vars={{ hubs }}>
            window.USER_HUBS = hubs;
        </script>

        <!-- Execute the WebGL Engine -->
        <script type="module" data-astro-rerun>
            import * as THREE from "three";
            import { OrbitControls } from "three/addons/controls/OrbitControls.js";
            import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";

            try {
                // ----------------------------------------------------
                // INTERACTIVE TUTORIAL STATE MACHINE
                // ----------------------------------------------------
                let completedVal = sessionStorage.getItem(
                    "brain_tutorial_completed",
                );
                if (completedVal === "3") {
                    sessionStorage.setItem("brain_tutorial_completed", "4");
                    completedVal = "4";
                }
                let tutorialState = parseInt(completedVal || "0");
                let cumulativeRotation = 0;
                let lastCameraPos = new THREE.Vector3();
                let initCameraDist = null;
                let tutorialActive = false;

                const onboardingControls = document.getElementById(
                    "onboarding-controls",
                );
                const restartTutorialBtn = document.getElementById(
                    "restart-tutorial-btn",
                );
                const skipTutorialBtn =
                    document.getElementById("skip-tutorial-btn");
                const tSteps = [
                    document.getElementById("tutorial-step-1"),
                    document.getElementById("tutorial-step-2"),
                    document.getElementById("tutorial-step-3"),
                    document.getElementById("tutorial-step-4"),
                ];

                function updateTutorialUI() {
                    if (tutorialState >= 4) {
                        if (onboardingControls) {
                            onboardingControls.style.opacity = "0";
                            onboardingControls.style.pointerEvents = "none";
                        }
                        if (restartTutorialBtn)
                            restartTutorialBtn.style.display = "flex";
                        return;
                    }

                    if (!tutorialActive) return;

                    if (restartTutorialBtn)
                        restartTutorialBtn.style.display = "none";
                    if (onboardingControls) {
                        onboardingControls.classList.remove("hidden");
                        setTimeout(() => {
                            if (
                                onboardingControls.style.opacity === "0" ||
                                onboardingControls.style.opacity === ""
                            ) {
                                onboardingControls.style.opacity = "1";
                            }
                        }, 50);
                    }

                    tSteps.forEach((step, index) => {
                        if (!step) return;
                        if (index === tutorialState) {
                            step.style.opacity = "1";
                            step.style.pointerEvents = "auto";
                            step.style.transform = "translateY(0)";
                        } else {
                            step.style.opacity = "0";
                            step.style.pointerEvents = "none";
                            step.style.transform = "translateY(4px)";
                        }
                    });
                }

                function advanceTutorial(targetState) {
                    if (tutorialState >= targetState || tutorialState >= 4)
                        return;
                    tutorialState = targetState;
                    if (tutorialState >= 4) {
                        sessionStorage.setItem("brain_tutorial_completed", "4");
                    }
                    if (tutorialState === 1) {
                        initCameraDist = camera.position.distanceTo(
                            controls.target,
                        );
                    }
                    updateTutorialUI();
                }

                if (skipTutorialBtn) {
                    skipTutorialBtn.addEventListener("pointerdown", (e) =>
                        e.stopPropagation(),
                    );
                    skipTutorialBtn.addEventListener("pointerup", (e) =>
                        e.stopPropagation(),
                    );
                    skipTutorialBtn.addEventListener("pointermove", (e) =>
                        e.stopPropagation(),
                    );
                    skipTutorialBtn.addEventListener("click", (e) => {
                        e.stopPropagation();
                        advanceTutorial(4);
                    });
                }

                if (restartTutorialBtn) {
                    restartTutorialBtn.addEventListener("pointerdown", (e) =>
                        e.stopPropagation(),
                    );
                    restartTutorialBtn.addEventListener("pointerup", (e) =>
                        e.stopPropagation(),
                    );
                    restartTutorialBtn.addEventListener("pointermove", (e) =>
                        e.stopPropagation(),
                    );
                    restartTutorialBtn.addEventListener("click", (e) => {
                        e.stopPropagation();
                        sessionStorage.removeItem("brain_tutorial_completed");
                        tutorialState = 0;
                        cumulativeRotation = 0;
                        initCameraDist = null;
                        updateTutorialUI();
                    });
                }

                // Initialize instantly for states >= 3 (Help Button)
                updateTutorialUI();

                // Wait for the cinematic entrance to finish before we display the UI
                setTimeout(() => {
                    tutorialActive = true;
                    updateTutorialUI();
                }, 3000);

                // ----------------------------------------------------
                // CORE ENGINE SETUP
                // ----------------------------------------------------
                const container = document.getElementById("webgl-container");
                const labelsContainer =
                    document.getElementById("labels-container");

                const scene = new THREE.Scene();
                // Add very faint distance fog so back-half of brain vanishes naturally
                scene.fog = new THREE.Fog(0x000000, 500, 2000);

                const camera = new THREE.PerspectiveCamera(
                    45,
                    window.innerWidth / window.innerHeight,
                    1,
                    30000,
                );
                camera.position.set(-16000, 6000, 16000); // Start way out off-center for a sweeping rotation entrance!

                const renderer = new THREE.WebGLRenderer({
                    antialias: true,
                    alpha: true,
                });
                renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
                renderer.setSize(window.innerWidth, window.innerHeight);
                renderer.localClippingEnabled = true; // Enables our X-Ray Tunnel shader!
                container.appendChild(renderer.domElement);

                // Map OrbitControls to the entire document body! This allows the user to click-and-drag right through the HTML label wrappers!
                const controls = new OrbitControls(camera, document.body);
                controls.enableDamping = true;
                controls.dampingFactor = 0.12;
                controls.enablePan = false; // Just zoom and rotate
                controls.minDistance = 50; // Let them fly ultra deep inside to inspect the leaves
                controls.maxDistance = 3000;

                // Tutorial Interaction Tracking
                controls.addEventListener("change", () => {
                    if (!tutorialActive || tutorialState >= 3) return;

                    if (tutorialState === 0) {
                        if (!initCameraDist) {
                            initCameraDist = camera.position.distanceTo(
                                controls.target,
                            );
                            lastCameraPos.copy(camera.position);
                        }
                        const distMoved = lastCameraPos.distanceTo(
                            camera.position,
                        );
                        cumulativeRotation += distMoved;
                        lastCameraPos.copy(camera.position);

                        if (cumulativeRotation > 500) {
                            advanceTutorial(1);
                        }
                    } else if (tutorialState === 1) {
                        if (!initCameraDist)
                            initCameraDist = camera.position.distanceTo(
                                controls.target,
                            );
                        const currentDist = camera.position.distanceTo(
                            controls.target,
                        );

                        if (Math.abs(initCameraDist - currentDist) > 150) {
                            advanceTutorial(2);
                        }
                    }
                });

                let activeFocusNodeName = null;

                // Cinematic Flight Engine State
                let isFlying = false;
                let flightAlpha = 0;
                let flightDuration = 1000;
                let flightStartTime = 0;
                const targetCameraPos = new THREE.Vector3();
                const startCameraPos = new THREE.Vector3();
                const targetControlsPos = new THREE.Vector3();
                const startControlsPos = new THREE.Vector3();

                // Dynamic Volumetric Clipping Engine
                const focusClipPlane = new THREE.Plane();

                // Execution function to propel the camera cleanly with linear mathematically tracked paths
                // Takes the 3D position to focus on, and how far away the camera should hover relative to its size
                function flyTo(
                    hubCenterVec,
                    zoomDistance = 450,
                    nodeName = null,
                    durationMs = 1500,
                ) {
                    flightDuration = durationMs;
                    flightStartTime = performance.now();
                    startCameraPos.copy(camera.position);
                    startControlsPos.copy(controls.target);
                    targetControlsPos.copy(hubCenterVec);

                    if (hubCenterVec.length() < 1) {
                        targetCameraPos.set(0, 0, zoomDistance);
                    } else {
                        const dir = hubCenterVec.clone().normalize();
                        targetCameraPos
                            .copy(hubCenterVec)
                            .add(dir.multiplyScalar(zoomDistance));
                    }

                    flightAlpha = 0;
                    isFlying = true;
                    activeFocusNodeName = nodeName; // Lock the shader focus

                    // Calculate the neighborhood logic dynamically!
                    if (nodeName && nodeName !== "CORE") {
                        window.activeVisibleNodes = new Set([nodeName]);
                        if (adjacencyMap.has(nodeName)) {
                            adjacencyMap
                                .get(nodeName)
                                .forEach((conn) =>
                                    window.activeVisibleNodes.add(conn),
                                );
                        }
                    } else {
                        window.activeVisibleNodes = new Set();
                    }

                    rebuildRaycastTargets(); // Dynamic Partitioning Update!

                    // Show notes only for the active localized neighborhood!
                    document.querySelectorAll(".layer-4-note").forEach((el) => {
                        if (
                            nodeName &&
                            nodeName !== "CORE" &&
                            window.activeVisibleNodes.has(el.dataset.name)
                        ) {
                            el.style.opacity = "1";
                        } else {
                            el.style.opacity = "0";
                        }
                    });

                    const focusCloseBtn =
                        document.getElementById("focus-close-btn");
                    if (focusCloseBtn) {
                        if (nodeName && nodeName !== "CORE") {
                            focusCloseBtn.style.opacity = "1";
                            focusCloseBtn.style.pointerEvents = "auto";
                        } else {
                            focusCloseBtn.style.opacity = "0";
                            focusCloseBtn.style.pointerEvents = "none";
                        }
                    }
                }

                // Global UI Ring for Hovering Nodes
                const ringGeo = new THREE.RingGeometry(1.2, 1.4, 32);
                const ringMat = new THREE.MeshBasicMaterial({
                    color: 0xffffff,
                    transparent: true,
                    opacity: 0.6,
                    side: THREE.DoubleSide,
                    depthWrite: false,
                });
                const hoverRing = new THREE.Mesh(ringGeo, ringMat);
                hoverRing.visible = false;
                scene.add(hoverRing);

                // Centralized Raycast Target Validator to physically block clicking/hovering of ghosted background meshes!
                function isValidTarget(mesh) {
                    const isFocused =
                        activeFocusNodeName !== null &&
                        activeFocusNodeName !== "CORE";
                    if (!isFocused) {
                        // Global view: Only nodes are interactive. Lines are ignored to prevent misclicks.
                        return !!mesh.userData.name;
                    } else {
                        // Focused view: Nodes are always interactive so they show the hover ring and can be clicked.
                        // Lines (endpoints) are only interactive if they link active visible nodes.
                        if (mesh.userData.name) {
                            return true;
                        } else if (mesh.userData.endpoints) {
                            return (
                                window.activeVisibleNodes.has(
                                    mesh.userData.endpoints[0],
                                ) &&
                                window.activeVisibleNodes.has(
                                    mesh.userData.endpoints[1],
                                )
                            );
                        }
                        return false;
                    }
                }

                const raycaster = new THREE.Raycaster();
                const mouse = new THREE.Vector2();
                const hoverMouse = new THREE.Vector2(-1000, -1000);
                let mouseMoved = false;
                const clickableMeshes = [];
                let raycastTargets = [];
                let hoveredObj = null;

                let currentCursor = "default";
                function setBodyCursor(newCursor) {
                    if (currentCursor !== newCursor) {
                        renderer.domElement.style.cursor = newCursor;
                        currentCursor = newCursor;
                    }
                }

                function rebuildRaycastTargets() {
                    raycastTargets = [];
                    clickableMeshes.forEach((mesh) => {
                        if (mesh.userData.name) {
                            raycastTargets.push(mesh);
                        }
                    });

                    const isFocused =
                        activeFocusNodeName !== null &&
                        activeFocusNodeName !== "CORE";
                    if (isFocused) {
                        clickableMeshes.forEach((mesh) => {
                            if (mesh.userData.endpoints) {
                                const connectsActive =
                                    window.activeVisibleNodes.has(
                                        mesh.userData.endpoints[0],
                                    ) &&
                                    window.activeVisibleNodes.has(
                                        mesh.userData.endpoints[1],
                                    );
                                if (connectsActive) {
                                    raycastTargets.push(mesh);
                                }
                            }
                        });
                    }
                }

                let pointerDownTime = 0;
                let pointerDownPos = new THREE.Vector2();

                window.addEventListener("pointermove", (event) => {
                    hoverMouse.x = (event.clientX / window.innerWidth) * 2 - 1;
                    hoverMouse.y =
                        -(event.clientY / window.innerHeight) * 2 + 1;
                    mouseMoved = true;

                    // FOCUS MODE UX: Dragging no longer breaks focus mode, allowing you to explore isolated nodes in focus.
                });

                window.addEventListener("pointerdown", (event) => {
                    pointerDownTime = Date.now();
                    pointerDownPos.set(event.clientX, event.clientY);
                });

                window.addEventListener("pointerup", (event) => {
                    pointerDownTime = 0;
                    // INTERCEPT UI BUTTON CLICKS GLOBALLY!
                    // OrbitControls systematically steals pointer capture mathematically onto `document.body` on Mechanical Mousedown.
                    // When standard UI labels lose pointer-capture, their localized `pointerup` functions are physically aborted natively.
                    // By hoisting the click logic evaluation completely up to the `window` scope, we evaluate the UI accurately while preserving OrbitControls camera dragging natively!
                    if (globalActiveClickState) {
                        const state = globalActiveClickState;
                        globalActiveClickState = null; // Consume state

                        const distHTML = Math.hypot(
                            state.dPos.x - event.clientX,
                            state.dPos.y - event.clientY,
                        );
                        if (distHTML < 30) {
                            advanceTutorial(3);
                            flyTo(
                                state.targetVector3,
                                state.zoomScalar,
                                state.nodeName,
                            );
                            return; // Successfully executed HTML button flyTo, abort Raycasting safely!
                        }
                    }

                    // Ignore if we explicitly dragged the mouse (OrbitControls navigation natively pans the camera!)
                    const dist = pointerDownPos.distanceTo(
                        new THREE.Vector2(event.clientX, event.clientY),
                    );
                    if (dist > 15) return;

                    // Ignore if we click a UI element explicitly so we don't double-fire
                    if (
                        event.target.tagName === "DIV" ||
                        event.target.tagName === "A" ||
                        event.target.tagName === "INPUT"
                    )
                        return;

                    mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
                    mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;
                    raycaster.setFromCamera(mouse, camera);

                    const intersects = raycaster
                        .intersectObjects(raycastTargets)
                        .filter((hit) => isValidTarget(hit.object));

                    if (intersects.length > 0) {
                        advanceTutorial(3);
                        let targetNodeMesh = intersects[0].object;

                        // If the user clicks a connection line instead of a node, travel down it!
                        if (targetNodeMesh.userData.endpoints) {
                            const [nameA, nameB] =
                                targetNodeMesh.userData.endpoints;
                            let targetName = nameB; // Default to traveling forwards/down

                            // If we are currently focused on one end of the line, travel to the other end!
                            if (activeFocusNodeName === nameB) {
                                targetName = nameA;
                            } else if (activeFocusNodeName === nameA) {
                                targetName = nameB;
                            }

                            // Locate the physical mesh of the destination node so we can calculate its size and position natively
                            const foundMesh = clickableMeshes.find(
                                (m) => m.userData.name === targetName,
                            );
                            if (foundMesh) {
                                targetNodeMesh = foundMesh;
                            }
                        }

                        // Determine zoom depth based on geometry size!
                        const targetMeshRef =
                            targetNodeMesh.userData.visibleMesh ||
                            targetNodeMesh;
                        const clickedRadius =
                            targetMeshRef.geometry.parameters.radius || 3;

                        let zoomScalar = 150;
                        if (clickedRadius >= 25) zoomScalar = 1500;
                        else if (clickedRadius >= 20) zoomScalar = 350;
                        else if (clickedRadius >= 8) zoomScalar = 250;

                        flyTo(
                            targetNodeMesh.position,
                            zoomScalar,
                            targetNodeMesh.userData.name || null,
                        );
                    } else {
                        // Reset focus mode if clicked on empty space!
                        if (
                            activeFocusNodeName !== null &&
                            activeFocusNodeName !== "CORE"
                        ) {
                            activeFocusNodeName = null;
                            document
                                .querySelectorAll(".layer-4-note")
                                .forEach((el) => {
                                    el.style.opacity = "0";
                                    el.style.pointerEvents = "none";
                                });
                            const focusCloseBtn =
                                document.getElementById("focus-close-btn");
                            if (focusCloseBtn) {
                                focusCloseBtn.style.opacity = "0";
                                focusCloseBtn.style.pointerEvents = "none";
                            }
                            rebuildRaycastTargets(); // Rebuild raycast targets since focus reset!
                            advanceTutorial(4);
                        }
                    }
                });

                let globalActiveClickState = null;

                // ----------------------------------------------------
                // UTILITY: Robust HTML Click Binder (Prevent drag zooming!)
                // ----------------------------------------------------
                function bindHTMLClick(
                    htmlElement,
                    targetVector3,
                    zoomScalar = 450,
                    nodeName = null,
                ) {
                    htmlElement.addEventListener("pointerdown", (e) => {
                        // Initialize the physical tracked pointer origin state dynamically!
                        globalActiveClickState = {
                            targetVector3: targetVector3,
                            zoomScalar: zoomScalar,
                            nodeName: nodeName,
                            dPos: { x: e.clientX, y: e.clientY },
                        };
                    });
                }

                // Core Lighting for the Faint Brain Shell
                const ambientLight = new THREE.AmbientLight(0xffffff, 0.5);
                scene.add(ambientLight);
                const directionalLight = new THREE.DirectionalLight(
                    0xffffff,
                    2,
                );
                directionalLight.position.set(1, 1, 1);
                scene.add(directionalLight);

                // --- NEW GRAPH ENGINE LOOKUP MAP ---
                const rawNodeDataMap = new Map();
                window.USER_HUBS.forEach((hub) => {
                    rawNodeDataMap.set(hub.name, {
                        baseColor: new THREE.Color(hub.color),
                    });
                    hub.categories.forEach((cat) => {
                        rawNodeDataMap.set(cat.name, {
                            baseColor: new THREE.Color(hub.color),
                        });
                        cat.items.forEach((item) => {
                            const itemName =
                                typeof item === "string" ? item : item.name;
                            rawNodeDataMap.set(itemName, {
                                baseColor: new THREE.Color(hub.color),
                            });
                        });
                    });
                });
                const globalNodeMap = new Map();
                const adjacencyMap = new Map();
                function addAdjacency(a, b) {
                    if (!adjacencyMap.has(a)) adjacencyMap.set(a, new Set());
                    if (!adjacencyMap.has(b)) adjacencyMap.set(b, new Set());
                    adjacencyMap.get(a).add(b);
                    adjacencyMap.get(b).add(a);
                }
                window.activeVisibleNodes = new Set();
                // ------------------------------------

                // ----------------------------------------------------
                // LAYER 1: THE EXPLICIT ASSET BRAIN BOUNDARY
                // ----------------------------------------------------
                const brainGroup = new THREE.Group();
                scene.add(brainGroup);

                // The "BrainFacts" style material - Translucent, glowing outline, wireframe accents
                const shellMatBase = new THREE.MeshPhongMaterial({
                    color: 0x1e3a8a,
                    transparent: true,
                    opacity: 0.05, // Extremely faint
                    side: THREE.DoubleSide,
                    blending: THREE.AdditiveBlending,
                    depthWrite: false,
                });

                // Add a secondary faint wireframe to explicitly highlight the bounds cleanly
                const shellMatWire = new THREE.MeshBasicMaterial({
                    color: 0x3b82f6,
                    transparent: true,
                    opacity: 0.03, // Toned down severely to not interfere with inner nodes
                    wireframe: true,
                    blending: THREE.AdditiveBlending,
                });

                // Use the Industry Standard GLTF Loader to load the actual artist-mapped medical brain
                const loader = new GLTFLoader();
                loader.load(
                    "/brain_low.glb",
                    (gltf) => {
                        const loadedModel = gltf.scene;

                        // Array to collect wireframes (cannot modify children while traversing them directly)
                        const wireframes = [];

                        // Strip default downloaded materials and apply explicit Ghost Shell aesthetics
                        loadedModel.traverse((child) => {
                            if (child.isMesh) {
                                child.material = shellMatBase;

                                // To get the wireframe perfectly on top without Z-fighting, we use an identical second mesh
                                const wireMesh = new THREE.Mesh(
                                    child.geometry,
                                    shellMatWire,
                                );
                                wireframes.push(wireMesh);
                            }
                        });

                        // Append all wireframes to the model natively
                        wireframes.forEach((w) => loadedModel.add(w));

                        // Auto-Center and Uniformly Scale the imported model (in case the downloaded model is massively huge or offset!)
                        const box = new THREE.Box3().setFromObject(loadedModel);
                        const size = box.getSize(new THREE.Vector3());
                        const center = box.getCenter(new THREE.Vector3());

                        // Snap the exact origin to 0,0,0
                        loadedModel.position.x +=
                            loadedModel.position.x - center.x;
                        loadedModel.position.y +=
                            loadedModel.position.y - center.y;
                        loadedModel.position.z +=
                            loadedModel.position.z - center.z;

                        // Re-scale the asset to physically map OVER our Neural Network system
                        // The interior system spans ~760 lengths on Z. We will map the max dimension of the downloaded model to 780 to wrap it perfectly.
                        const targetLength = 780;
                        const maxDimension = Math.max(size.x, size.y, size.z);
                        const scaleFactor = targetLength / maxDimension;
                        loadedModel.scale.set(
                            scaleFactor,
                            scaleFactor,
                            scaleFactor,
                        );
                        window.brainModelRef = loadedModel;

                        // The downloaded model might require default Y-rotation if it faces the wrong way, we will rotate it slightly for optimal starting angle
                        loadedModel.rotation.y = Math.PI / 2; // Spin it 90 degrees just to see the side profile better immediately

                        brainGroup.add(loadedModel);
                        // PERFORMANCE FIX: Pre-compile all shaders NOW while the screen is black!
                        // This prevents the massive main-thread lag spike when the model first renders.
                        renderer.compile(scene, camera);

                        // Start the cinematic flight!
                        if (window.startCinematicEntrance) {
                            window.startCinematicEntrance();
                            window.startCinematicEntrance = null; // Prevent double-firing from fallback timeout
                        }
                    },
                    undefined,
                    (error) => {
                        console.error("GLTF Loading Error:", error);
                        // If the massive brain asset fails to load, STILL start the experience so the user isn't stuck on a black screen!
                        if (window.startCinematicEntrance) {
                            window.startCinematicEntrance();
                            window.startCinematicEntrance = null;
                        }
                    },
                );

                // ----------------------------------------------------
                // LAYER 2: THE DATA HUBS AND FLOATING LABELS
                // ----------------------------------------------------
                const HTML_LABELS = []; // We will map these coordinates every frame

                // THE NEURAL CORE (Return to Center!)
                const coreReturnGeo = new THREE.SphereGeometry(25, 32, 32);
                // Explicitly colored dark gray to heavily contrast against the bright white text overlaid on top of it!
                const coreReturnMat = new THREE.MeshBasicMaterial({
                    color: 0x222222,
                    transparent: true,
                });
                const coreReturnMesh = new THREE.Mesh(
                    coreReturnGeo,
                    coreReturnMat,
                );
                coreReturnMesh.position.set(0, 0, 0);
                coreReturnMesh.userData.treeId = "CORE"; // Explicitly map it so it fades correctly
                scene.add(coreReturnMesh);
                clickableMeshes.push(coreReturnMesh); // Add to Raycaster

                // Lighting for the mechanical core
                const coreLight = new THREE.PointLight(0xffffff, 150, 900);
                coreReturnMesh.add(coreLight);

                // UI Label for the mechanical core
                const coreLabelEl = document.createElement("div");
                coreLabelEl.style.willChange = "transform, opacity";
                // Explicitly removed CSS translate logic entirely + explicitly forced Javascript Transform-Origin Center
                coreLabelEl.className =
                    "absolute top-0 left-0 font-bold text-6xl sans-serif tracking-tight select-none pointer-events-auto cursor-pointer z-50 origin-center text-white";
                coreLabelEl.style.textShadow = `0px 2px 4px #000, 0px 0px 10px #000, 0px 0px 20px #000, 0px 0px 40px #000, 0px 0px 60px rgba(255, 255, 255, 0.5)`;
                coreLabelEl.innerText = "NEURAL CORE";

                bindHTMLClick(
                    coreLabelEl,
                    coreReturnMesh.position,
                    1500,
                    "CORE",
                );
                labelsContainer.appendChild(coreLabelEl);
                HTML_LABELS.push({
                    element: coreLabelEl,
                    clickTarget: coreLabelEl,
                    position: new THREE.Vector3(0, 0, 0),
                    type: "hub",
                    treeId: "CORE",
                    name: "CORE",
                });

                // Utility: Calculate the circular mean of HSL colors to keep blends saturated and pure
                function averageColorsHSL(colorArray) {
                    if (colorArray.length === 0) return new THREE.Color();
                    if (colorArray.length === 1) return colorArray[0].clone();

                    let sumX = 0;
                    let sumY = 0;
                    let sumS = 0;
                    let sumL = 0;

                    const tempHSL = { h: 0, s: 0, l: 0 };
                    colorArray.forEach((c) => {
                        c.getHSL(tempHSL);
                        const angle = tempHSL.h * Math.PI * 2;
                        sumX += Math.cos(angle);
                        sumY += Math.sin(angle);
                        sumS += tempHSL.s;
                        sumL += tempHSL.l;
                    });

                    const count = colorArray.length;
                    const avgX = sumX / count;
                    const avgY = sumY / count;
                    const avgS = sumS / count;
                    const avgL = sumL / count;

                    let avgH = Math.atan2(avgY, avgX) / (Math.PI * 2);
                    if (avgH < 0) avgH += 1.0;

                    const result = new THREE.Color();
                    result.setHSL(avgH, avgS, avgL);
                    return result;
                }

                // Utility: Blend two colors using HSL shortest-path interpolation
                function blendColorsHSL(colorA, colorB, alpha) {
                    const hslA = { h: 0, s: 0, l: 0 };
                    const hslB = { h: 0, s: 0, l: 0 };
                    colorA.getHSL(hslA);
                    colorB.getHSL(hslB);

                    let hA = hslA.h;
                    let hB = hslB.h;
                    let diff = hB - hA;
                    if (diff > 0.5) {
                        hA += 1.0;
                    } else if (diff < -0.5) {
                        hB += 1.0;
                    }

                    const h = (hA + (hB - hA) * alpha) % 1.0;
                    const s = hslA.s + (hslB.s - hslA.s) * alpha;
                    const l = hslA.l + (hslB.l - hslA.l) * alpha;

                    const result = new THREE.Color();
                    result.setHSL(h, s, l);
                    return result;
                }

                // Utility: Generate physical WebGL 3D cylinder pipes to bypass LineBasicMaterial maximum 1px width limits on Windows/Angle drivers!
                function createThickLine(
                    vStart,
                    vEnd,
                    colorObj,
                    thickness,
                    opacity,
                    treeId,
                    nameA,
                    nameB,
                ) {
                    const distance = vStart.distanceTo(vEnd);
                    const cylinderGeo = new THREE.CylinderGeometry(
                        thickness,
                        thickness,
                        distance,
                        6,
                        1,
                        false,
                    );
                    // Translate the geometry pivot to the base so we can perfectly lookAt the target!
                    cylinderGeo.translate(0, distance / 2, 0);
                    cylinderGeo.rotateX(Math.PI / 2);

                    const mat = new THREE.MeshBasicMaterial({
                        color: colorObj,
                        transparent: true,
                        opacity: opacity,
                    });
                    const mesh = new THREE.Mesh(cylinderGeo, mat);
                    mesh.position.copy(vStart);
                    mesh.lookAt(vEnd);
                    mesh.userData.treeId = treeId; // Bind it to the Ghost Opacity Engine!
                    mesh.userData.baseColor = colorObj.clone();
                    mesh.userData.baseOpacity = opacity;
                    if (nameA && nameB) {
                        mesh.userData.endpoints = [nameA, nameB];
                    }

                    scene.add(mesh);
                    clickableMeshes.push(mesh); // Track it alongside everything else so the Opacity Engine loops over it automatically!

                    // Create an invisible, thicker Hitbox so skinny lines are easy to click
                    if (nameA && nameB) {
                        const hitGeo = new THREE.CylinderGeometry(
                            Math.max(thickness + 5, 8),
                            Math.max(thickness + 5, 8),
                            distance,
                            6,
                            1,
                            false,
                        );
                        hitGeo.translate(0, distance / 2, 0);
                        hitGeo.rotateX(Math.PI / 2);

                        const hitMat = new THREE.MeshBasicMaterial({
                            transparent: true,
                            opacity: 0,
                            depthWrite: false, // Prevents z-fighting invisibly
                        });
                        const hitMesh = new THREE.Mesh(hitGeo, hitMat);
                        hitMesh.position.copy(vStart);
                        hitMesh.lookAt(vEnd);

                        hitMesh.userData.endpoints = [nameA, nameB];
                        hitMesh.userData.hitMesh = true;
                        hitMesh.userData.visibleMesh = mesh; // Link for the Opacity Engine!
                        addAdjacency(nameA, nameB);

                        scene.add(hitMesh);
                        clickableMeshes.push(hitMesh);
                    }
                }

                window.USER_HUBS.forEach((hub) => {
                    // Massive Bright Glowing Core (or category-sized for floating nodes)
                    const isFloating = !!hub.isFloating;
                    const radius = isFloating ? 8 : 20;
                    const coreGeo = new THREE.SphereGeometry(radius, 32, 32);
                    // Ensuring the mesh IS colored solidly and intrinsically handles transparency dynamically
                    const coreMat = new THREE.MeshBasicMaterial({
                        color: hub.color,
                        transparent: true,
                    });
                    const coreMesh = new THREE.Mesh(coreGeo, coreMat);
                    coreMesh.position.set(hub.x, hub.y, hub.z);
                    coreMesh.userData.treeId = hub.id; // Map specifically to isolate Focus trees!
                    coreMesh.userData.name = hub.name;
                    coreMesh.userData.baseColor = new THREE.Color(hub.color);
                    scene.add(coreMesh);
                    clickableMeshes.push(coreMesh); // Add to Raycaster

                    // Add literal Light Source so the brain shell glows around the Hub!
                    const lightIntensity = isFloating ? 20 : 100;
                    const lightDistance = isFloating ? 200 : 800;
                    const light = new THREE.PointLight(
                        hub.color,
                        lightIntensity,
                        lightDistance,
                    );
                    coreMesh.add(light);

                    // Create HTML Label Element (Tier 1 or Tier 2 sized depending on isFloating)
                    const labelEl = document.createElement("div");
                    labelEl.style.willChange = "transform, opacity";
                    // Explicitly destroyed mix-blend-screen and forced stark organic black backing!
                    if (isFloating) {
                        labelEl.className =
                            "absolute top-0 left-0 font-mono text-5xl font-bold tracking-widest text-white uppercase select-none pointer-events-auto cursor-pointer z-40 origin-center";
                        labelEl.style.textShadow = `0px 2px 4px #000, 0px 0px 10px #000, 0px 0px 20px #000, 0px 0px 30px #000, 0px 0px 40px ${hub.cssColor}`;
                    } else {
                        labelEl.className =
                            "absolute top-0 left-0 font-bold text-6xl sans-serif tracking-tight select-none pointer-events-auto cursor-pointer z-50 origin-center text-white";
                        labelEl.style.textShadow = `0px 2px 4px #000, 0px 0px 10px #000, 0px 0px 20px #000, 0px 0px 40px #000, 0px 0px 60px ${hub.cssColor}`;
                    }
                    labelEl.innerText = hub.name;

                    // Execute physical camera flight cleanly using our custom binder, propagating specific treeId!
                    const zoomDistance = isFloating ? 250 : 400;
                    bindHTMLClick(
                        labelEl,
                        coreMesh.position,
                        zoomDistance,
                        hub.name,
                    );

                    labelsContainer.appendChild(labelEl);

                    HTML_LABELS.push({
                        element: labelEl,
                        clickTarget: labelEl,
                        position: new THREE.Vector3(hub.x, hub.y, hub.z),
                        type: isFloating ? "category" : "hub",
                        treeId: hub.id,
                        name: hub.name,
                    });

                    globalNodeMap.set(hub.name, {
                        position: new THREE.Vector3(hub.x, hub.y, hub.z),
                        color: new THREE.Color(hub.color),
                        treeId: hub.id,
                    });
                });

                // ----------------------------------------------------
                // LAYER 3: THE DENSER INTERNAL NETWORK MASS (Points + Lines))
                // ----------------------------------------------------
                const sliderDensity = document.getElementById("slider-density");
                const labelDensity = document.getElementById("label-density");
                const sliderConnections =
                    document.getElementById("slider-connections");
                const labelConnections =
                    document.getElementById("label-connections");

                // Establish memory state references to safely destroy objects when the user interacts dynamically!
                let pointGeoRef = null;
                let lineGeoRef = null;
                let ambientNodesMesh = null;
                let ambientLineMesh = null;

                function rebuildAmbientNetwork() {
                    if (ambientNodesMesh) {
                        scene.remove(ambientNodesMesh);
                        clickableMeshes.splice(
                            clickableMeshes.indexOf(ambientNodesMesh),
                            1,
                        );
                        ambientNodesMesh.geometry.dispose();
                        ambientNodesMesh.material.dispose();
                        ambientNodesMesh = null;
                    }
                    if (ambientLineMesh) {
                        scene.remove(ambientLineMesh);
                        clickableMeshes.splice(
                            clickableMeshes.indexOf(ambientLineMesh),
                            1,
                        );
                        ambientLineMesh.geometry.dispose();
                        ambientLineMesh.material.dispose();
                        ambientLineMesh = null;
                    }
                    if (pointGeoRef) {
                        pointGeoRef.dispose();
                        pointGeoRef = null;
                    }
                    if (lineGeoRef) {
                        lineGeoRef.dispose();
                        lineGeoRef = null;
                    }

                    // Live-read the exact mathematical slider values from the specific overlay
                    const nodeCount = parseInt(sliderDensity.value);
                    const THRESHOLD = parseInt(sliderConnections.value);

                    if (nodeCount === 0) return;

                    const positions = new Float32Array(nodeCount * 3);

                    let pIndex = 0;
                    const activeNodeCount = nodeCount;

                    for (let i = 0; i < activeNodeCount; i++) {
                        let bx, by, bz;
                        // Rejection loop: ensure points are securely tightly bound inside biological requirements
                        let validPoint = false;
                        while (!validPoint) {
                            let x = (Math.random() - 0.5) * 2;
                            let y = (Math.random() - 0.5) * 2;
                            let z = (Math.random() - 0.5) * 2;

                            if (x * x + y * y + z * z < 1) {
                                // Standard spherical container
                                bx = x * 320;
                                by = y * 280 + 50;
                                bz = z * 370;

                                // Strict Biological Space Check: Frontal/Temporal Overhang "Cinema Plane" cut!
                                // Based definitively on the line drawn straight from Core (0,0,0) down to Cinema (0, -50, -200)
                                // If z is in the Front (negative depths), and y is physically underneath that specific 25% mathematical slope, slice it!
                                if (bz < 0 && by < bz * 0.25) {
                                    validPoint = false;
                                } else {
                                    validPoint = true;
                                }
                            }
                        }

                        positions[pIndex++] = bx;
                        positions[pIndex++] = by;
                        positions[pIndex++] = bz;
                    }

                    pointGeoRef = new THREE.BufferGeometry();
                    pointGeoRef.setAttribute(
                        "position",
                        new THREE.BufferAttribute(positions, 3),
                    );
                    const pointMat = new THREE.PointsMaterial({
                        color: 0xffffff,
                        size: 5,
                        transparent: true,
                        opacity: 0.5,
                        blending: THREE.AdditiveBlending,
                    });
                    ambientNodesMesh = new THREE.Points(pointGeoRef, pointMat);
                    ambientNodesMesh.userData.isAmbient = true; // Wire to the opacity ghost engine natively
                    scene.add(ambientNodesMesh);
                    clickableMeshes.push(ambientNodesMesh); // Push so the loop can hit it!

                    // Execute brute force O(N^2) line connection generation safely
                    const linePositions = [];
                    const lineColors = [];
                    const colorBlue = new THREE.Color(0x3b82f6);
                    const colorOrange = new THREE.Color(0xea580c);

                    for (let i = 0; i < nodeCount; i++) {
                        const v1 = new THREE.Vector3(
                            positions[i * 3],
                            positions[i * 3 + 1],
                            positions[i * 3 + 2],
                        );
                        const nodeColor =
                            Math.random() > 0.4 ? colorBlue : colorOrange;

                        for (let j = i + 1; j < nodeCount; j++) {
                            const v2 = new THREE.Vector3(
                                positions[j * 3],
                                positions[j * 3 + 1],
                                positions[j * 3 + 2],
                            );
                            if (v1.distanceTo(v2) < THRESHOLD) {
                                linePositions.push(v1.x, v1.y, v1.z);
                                linePositions.push(v2.x, v2.y, v2.z);
                                lineColors.push(
                                    nodeColor.r,
                                    nodeColor.g,
                                    nodeColor.b,
                                );
                                lineColors.push(
                                    nodeColor.r,
                                    nodeColor.g,
                                    nodeColor.b,
                                );
                            }
                        }
                    }

                    if (linePositions.length > 0) {
                        lineGeoRef = new THREE.BufferGeometry();
                        lineGeoRef.setAttribute(
                            "position",
                            new THREE.Float32BufferAttribute(linePositions, 3),
                        );
                        lineGeoRef.setAttribute(
                            "color",
                            new THREE.Float32BufferAttribute(lineColors, 3),
                        );

                        const lineMat = new THREE.LineBasicMaterial({
                            vertexColors: true,
                            transparent: true,
                            opacity: 0.25,
                            blending: THREE.AdditiveBlending,
                        });
                        ambientLineMesh = new THREE.LineSegments(
                            lineGeoRef,
                            lineMat,
                        );
                        ambientLineMesh.userData.isAmbient = true;
                        scene.add(ambientLineMesh);
                        clickableMeshes.push(ambientLineMesh);
                    }
                }

                // Initialize natively
                rebuildAmbientNetwork();

                // ----------------------------------------------------
                // LISTENERS: Live Physics Engine WebGL Tuning Hooks
                // ----------------------------------------------------
                // Shield structural Interface components permanently from OrbitControls stealing clicks natively!
                const controlPanel = document.getElementById("control-panel");
                controlPanel.addEventListener("pointerdown", (e) =>
                    e.stopPropagation(),
                );
                controlPanel.addEventListener("pointerup", (e) =>
                    e.stopPropagation(),
                );
                controlPanel.addEventListener("pointermove", (e) =>
                    e.stopPropagation(),
                );

                const focusCloseBtn =
                    document.getElementById("focus-close-btn");
                if (focusCloseBtn) {
                    focusCloseBtn.addEventListener("pointerdown", (e) =>
                        e.stopPropagation(),
                    );
                    focusCloseBtn.addEventListener("pointerup", (e) =>
                        e.stopPropagation(),
                    );
                    focusCloseBtn.addEventListener("pointermove", (e) =>
                        e.stopPropagation(),
                    );
                    focusCloseBtn.addEventListener("click", (e) => {
                        e.preventDefault();
                        activeFocusNodeName = null;
                        document
                            .querySelectorAll(".layer-4-note")
                            .forEach((el) => (el.style.opacity = "0"));
                        focusCloseBtn.style.opacity = "0";
                        focusCloseBtn.style.pointerEvents = "none";
                        advanceTutorial(4);
                    });
                }

                const exitBtn = document.getElementById("exit-btn");
                exitBtn.addEventListener("pointerdown", (e) =>
                    e.stopPropagation(),
                );
                exitBtn.addEventListener("pointerup", (e) =>
                    e.stopPropagation(),
                );
                exitBtn.addEventListener("pointermove", (e) =>
                    e.stopPropagation(),
                );

                // Custom exit logic to seamlessly reverse the cinematic transition
                exitBtn.addEventListener("click", (e) => {
                    e.preventDefault();
                    const overlay = document.getElementById(
                        "brain-entrance-overlay",
                    );
                    const labelsContainer =
                        document.getElementById("labels-container");
                    if (labelsContainer) labelsContainer.style.display = "none"; // Instantly hide labels to prevent DOM lag!

                    // Fly out slowly into the deep void (20000) over 3.5s so it NEVER stops before navigation!
                    flyTo(new THREE.Vector3(0, 0, 0), 20000, "CORE", 3500);

                    // Wait slightly before starting the fade to black so the user sees the backward flight
                    setTimeout(() => {
                        if (overlay) overlay.style.opacity = "1";
                    }, 500);

                    // Navigate strictly before the flight finishes (1.5s)
                    setTimeout(() => {
                        sessionStorage.setItem("from_brain", "true"); // Required to trigger the reverse 'o' zoom on the home page!
                        const link = document.createElement("a");
                        link.href = "/";
                        link.setAttribute("data-astro-reload", "");
                        document.body.appendChild(link);
                        link.click();
                    }, 1500);
                });

                function updateDensityLabel(val) {
                    if (val <= 200) return "Super realistic mode";
                    if (val <= 400) return "Maybe on a good day";
                    if (val <= 600) return "A bit generous";
                    if (val <= 800) return "Now we're just lying";
                    return "Psshhh in my dreams";
                }

                function updateConnectionsLabel(val) {
                    if (val <= 60) return "What was I saying?";
                    if (val <= 110) return "Connecting the dots...";
                    if (val <= 160) return "Actually making sense";
                    if (val <= 210) return "Galaxy Brain unlocking";
                    return "Who needs anchor points?";
                }

                // Initialize natively
                labelDensity.innerText = updateDensityLabel(
                    parseInt(sliderDensity.value),
                );
                labelConnections.innerText = updateConnectionsLabel(
                    parseInt(sliderConnections.value),
                );

                // Update the visual string on slide without rebuilding 3D
                sliderDensity.addEventListener("input", () => {
                    labelDensity.innerText = updateDensityLabel(
                        parseInt(sliderDensity.value),
                    );
                });
                sliderConnections.addEventListener("input", () => {
                    labelConnections.innerText = updateConnectionsLabel(
                        parseInt(sliderConnections.value),
                    );
                });

                // ONLY trigger the massive WebGL structural rebuild natively when the mouse releases the slider!
                // This prevents the slider dragging interaction from permanently locking the UI loop rendering thread!
                sliderDensity.addEventListener("change", () => {
                    rebuildAmbientNetwork();
                });

                sliderConnections.addEventListener("change", () => {
                    rebuildAmbientNetwork();
                });

                // Inject the precise Hobbies/Children tightly grouped into 3-Tier Networks
                window.USER_HUBS.forEach((hub) => {
                    if (
                        hub.isFloating &&
                        (!hub.categories || hub.categories.length === 0)
                    )
                        return;
                    const hubCenter = new THREE.Vector3(hub.x, hub.y, hub.z);

                    // TIER 2: The Core Categories (e.g. Movies, Tabletop)
                    // SCREEN-SPACE REJECTION SAMPLING ENGINE
                    // We use the View Vector to project 3D random attempts onto a virtual 2D canvas to strictly guarantee no visual overlap!
                    const hubOptimumViewDir = hubCenter.clone().normalize();
                    let upVec = new THREE.Vector3(0, 1, 0);
                    const rightVec = new THREE.Vector3().crossVectors(
                        hubOptimumViewDir,
                        upVec,
                    );
                    if (rightVec.lengthSq() < 0.001) {
                        upVec.set(1, 0, 0);
                        rightVec.crossVectors(hubOptimumViewDir, upVec);
                    }
                    rightVec.normalize();
                    upVec.crossVectors(rightVec, hubOptimumViewDir).normalize();

                    // Native function to flatten 3D points onto that specific camera plane
                    function toScreen(vec3) {
                        const diff = vec3.clone().sub(hubCenter);
                        return { x: diff.dot(rightVec), y: diff.dot(upVec) };
                    }
                    // Mathematical collision math line-to-point
                    function distToSegment(p, v, w) {
                        const l2 =
                            (w.x - v.x) * (w.x - v.x) +
                            (w.y - v.y) * (w.y - v.y);
                        if (l2 == 0) return Math.hypot(p.x - v.x, p.y - v.y);
                        let t =
                            ((p.x - v.x) * (w.x - v.x) +
                                (p.y - v.y) * (w.y - v.y)) /
                            l2;
                        t = Math.max(0, Math.min(1, t));
                        const projX = v.x + t * (w.x - v.x);
                        const projY = v.y + t * (w.y - v.y);
                        return Math.hypot(p.x - projX, p.y - projY);
                    }

                    // Track occupied space from this visual plane specifically
                    const occupied = [];
                    occupied.push({
                        obj: toScreen(hubCenter),
                        type: "node",
                        r: 40,
                    }); // Hub core

                    hub.categories.forEach((cat, catIndex) => {
                        let catPos;
                        let c2D;
                        if (cat.invisibleCategory) {
                            catPos = hubCenter.clone();
                            c2D = toScreen(catPos);
                        } else {
                            // Execute a brute-force randomized scattered trial up to 200 times purely to find a non-overlapping chaotic vector!
                            for (let attempt = 0; attempt < 200; attempt++) {
                                const rXYZ = new THREE.Vector3(
                                    (Math.random() - 0.5) * 2,
                                    (Math.random() - 0.5) * 2,
                                    (Math.random() - 0.5) * 2,
                                ).normalize();
                                const dist = 40 + Math.random() * 30; // Drastically tightened max boundary down relative to Layer 1 Core to satisfy user constraint
                                const candidate = hubCenter
                                    .clone()
                                    .add(rXYZ.multiplyScalar(dist));

                                const cand2D = toScreen(candidate);
                                const source2D = toScreen(hubCenter);
                                let overlap = false;

                                for (let s of occupied) {
                                    if (s.type === "node") {
                                        // Tighter bounding requirements to permit denser, shorter clusters
                                        if (
                                            Math.hypot(
                                                cand2D.x - s.obj.x,
                                                cand2D.y - s.obj.y,
                                            ) <
                                            s.r + 20
                                        )
                                            overlap = true;

                                        const isSourceNode =
                                            Math.hypot(
                                                s.obj.x - source2D.x,
                                                s.obj.y - source2D.y,
                                            ) < 1;
                                        const isCandNode =
                                            Math.hypot(
                                                s.obj.x - cand2D.x,
                                                s.obj.y - cand2D.y,
                                            ) < 1;
                                        if (!isSourceNode && !isCandNode) {
                                            if (
                                                distToSegment(
                                                    s.obj,
                                                    source2D,
                                                    cand2D,
                                                ) <
                                                s.r + 5
                                            )
                                                overlap = true;
                                        }
                                    } else if (s.type === "line") {
                                        if (
                                            distToSegment(cand2D, s.p1, s.p2) <
                                            15
                                        )
                                            overlap = true;
                                    }
                                    if (overlap) break;
                                }
                                if (!overlap) {
                                    catPos = candidate;
                                    c2D = cand2D;
                                    break;
                                }
                            }

                            // Fallback math failsafe if tree is incredibly dense
                            if (!catPos) {
                                const fallbackAngle =
                                    (catIndex / hub.categories.length) *
                                    Math.PI *
                                    2;
                                catPos = hubCenter
                                    .clone()
                                    .add(
                                        new THREE.Vector3(
                                            Math.cos(fallbackAngle) * 50,
                                            150,
                                            Math.sin(fallbackAngle) * 50,
                                        ),
                                    );
                                c2D = toScreen(catPos);
                            }

                            // Shrink the enforced bounding area heavily so dense clusters succeed natively
                            occupied.push({ obj: c2D, type: "node", r: 25 });
                            occupied.push({
                                p1: toScreen(hubCenter),
                                p2: c2D,
                                type: "line",
                            });
                        }

                        // Calculate 60/40 blended color for the category!
                        let catColor = new THREE.Color(hub.color);
                        let catCssColor = hub.cssColor;

                        if (
                            typeof cat === "object" &&
                            cat.secondaryParents &&
                            cat.secondaryParents.length > 0
                        ) {
                            const pColors = [];
                            cat.secondaryParents.forEach((pName) => {
                                if (rawNodeDataMap.has(pName)) {
                                    pColors.push(
                                        rawNodeDataMap.get(pName).baseColor,
                                    );
                                }
                            });
                            if (pColors.length > 0) {
                                const avgSecColor = averageColorsHSL(pColors);
                                catColor = blendColorsHSL(
                                    catColor,
                                    avgSecColor,
                                    0.4,
                                ); // 60% primary, 40% secondary
                                catCssColor = `rgba(${Math.round(catColor.r * 255)}, ${Math.round(catColor.g * 255)}, ${Math.round(catColor.b * 255)}, 0.8)`;
                            }
                        }

                        // Save category color back to rawNodeDataMap for the waterfall
                        if (rawNodeDataMap.has(cat.name)) {
                            rawNodeDataMap.get(cat.name).baseColor =
                                catColor.clone();
                        }

                        // Generation: Category Mesh (Medium Node)
                        if (!cat.invisibleCategory) {
                            const cG = new THREE.SphereGeometry(8, 16, 16);
                            const cM = new THREE.MeshBasicMaterial({
                                color: catColor,
                                transparent: true,
                            });
                            const catMeshRender = new THREE.Mesh(cG, cM);
                            catMeshRender.position.copy(catPos);
                            catMeshRender.userData.treeId = hub.id;
                            catMeshRender.userData.name = cat.name;
                            catMeshRender.userData.baseColor = catColor.clone();
                            scene.add(catMeshRender);

                            // Generation: Hidden Enlarged Cursor Hitbox - Solving tiny 3D pointer accuracy natively!
                            const hitGeo = new THREE.SphereGeometry(15, 8, 8);
                            const hitMat = new THREE.MeshBasicMaterial({
                                visible: false,
                            });
                            const hitMesh = new THREE.Mesh(hitGeo, hitMat);
                            hitMesh.position.copy(catPos);
                            hitMesh.userData.hitMesh = true;
                            hitMesh.userData.visibleMesh = catMeshRender;
                            hitMesh.userData.name = cat.name;
                            hitMesh.userData.treeId = hub.id;

                            scene.add(hitMesh);
                            clickableMeshes.push(hitMesh);
                            clickableMeshes.push(catMeshRender);

                            // Generation: Thick Hierarchical Link directly to Parent Hub
                            createThickLine(
                                hubCenter,
                                catPos,
                                new THREE.Color(hub.color),
                                1.8,
                                0.8,
                                hub.id,
                                hub.name,
                                cat.name,
                            );

                            // Bind HTML label for the CATEGORY node
                            const catEl = document.createElement("div");
                            catEl.className =
                                "absolute top-0 left-0 font-mono text-5xl font-bold tracking-widest text-white uppercase select-none pointer-events-auto cursor-pointer z-40 origin-center";
                            catEl.innerText = cat.name;
                            catEl.style.textShadow = `0px 2px 4px #000, 0px 0px 10px #000, 0px 0px 20px #000, 0px 0px 30px #000, 0px 0px 40px ${catCssColor}`;

                            bindHTMLClick(catEl, catPos, 250, cat.name);
                            labelsContainer.appendChild(catEl);

                            HTML_LABELS.push({
                                element: catEl,
                                clickTarget: catEl,
                                position: catPos,
                                type: "category",
                                treeId: hub.id,
                                name: cat.name,
                            });
                        }

                        globalNodeMap.set(cat.name, {
                            position: catPos,
                            color: catColor,
                            treeId: hub.id,
                        });

                        // TIER 3: The Leaf Items (e.g. Tenet, Poker)
                        cat.items.forEach((item, index) => {
                            const itemName =
                                typeof item === "string" ? item : item.name;
                            let itemPos;
                            let i2D;
                            for (let attempt = 0; attempt < 300; attempt++) {
                                const rXYZ = new THREE.Vector3(
                                    (Math.random() - 0.5) * 2,
                                    (Math.random() - 0.5) * 2,
                                    (Math.random() - 0.5) * 2,
                                ).normalize();
                                const dist = cat.invisibleCategory
                                    ? 42 + Math.random() * 18
                                    : 35 + Math.random() * 45; // Dropping max depth out by 40 units recursively wraps the items deeply around Category nodes so they don't break the active screen borders
                                const candidate = catPos
                                    .clone()
                                    .add(rXYZ.multiplyScalar(dist));

                                const cand2D = toScreen(candidate);
                                let overlap = false;

                                for (
                                    let idx = 0;
                                    idx < occupied.length;
                                    idx++
                                ) {
                                    if (cat.invisibleCategory && idx === 0)
                                        continue;
                                    const s = occupied[idx];
                                    if (s.type === "node") {
                                        if (
                                            Math.hypot(
                                                cand2D.x - s.obj.x,
                                                cand2D.y - s.obj.y,
                                            ) <
                                            s.r + 10
                                        )
                                            overlap = true;

                                        const isSourceNode =
                                            Math.hypot(
                                                s.obj.x - c2D.x,
                                                s.obj.y - c2D.y,
                                            ) < 1;
                                        const isCandNode =
                                            Math.hypot(
                                                s.obj.x - cand2D.x,
                                                s.obj.y - cand2D.y,
                                            ) < 1;
                                        if (!isSourceNode && !isCandNode) {
                                            if (
                                                distToSegment(
                                                    s.obj,
                                                    c2D,
                                                    cand2D,
                                                ) <
                                                s.r + 5
                                            )
                                                overlap = true;
                                        }
                                    } else if (s.type === "line") {
                                        if (
                                            distToSegment(cand2D, s.p1, s.p2) <
                                            10
                                        )
                                            overlap = true;
                                    }
                                    if (overlap) break;
                                }
                                if (!overlap) {
                                    itemPos = candidate;
                                    i2D = cand2D;
                                    break;
                                }
                            }
                            if (!itemPos) {
                                const fallbackAngle =
                                    (index / cat.items.length) * Math.PI * 2;
                                const fallbackDist = cat.invisibleCategory
                                    ? 20
                                    : 30;
                                const fallbackY = cat.invisibleCategory
                                    ? -20
                                    : -50;
                                itemPos = catPos
                                    .clone()
                                    .add(
                                        new THREE.Vector3(
                                            Math.cos(fallbackAngle) *
                                                fallbackDist,
                                            fallbackY,
                                            Math.sin(fallbackAngle) *
                                                fallbackDist,
                                        ),
                                    );
                                i2D = toScreen(itemPos);
                            }
                            // Severely shrunk the collision geometry bounds to allow dense neural structures to pack optimally!
                            occupied.push({ obj: i2D, type: "node", r: 15 });
                            occupied.push({ p1: c2D, p2: i2D, type: "line" });

                            // Calculate 60/40 blended color for the item!
                            let itemColor = new THREE.Color(catColor);
                            let cssColor = catCssColor; // Used for text shadow natively

                            if (
                                typeof item === "object" &&
                                item.secondaryParents &&
                                item.secondaryParents.length > 0
                            ) {
                                const pColors = [];
                                item.secondaryParents.forEach((pName) => {
                                    if (rawNodeDataMap.has(pName)) {
                                        pColors.push(
                                            rawNodeDataMap.get(pName).baseColor,
                                        );
                                    }
                                });
                                if (pColors.length > 0) {
                                    const avgSecColor =
                                        averageColorsHSL(pColors);
                                    itemColor = blendColorsHSL(
                                        itemColor,
                                        avgSecColor,
                                        0.4,
                                    ); // 60% primary, 40% secondary
                                    // Map back to css rgba for the dynamic text shadow
                                    cssColor = `rgba(${Math.round(itemColor.r * 255)}, ${Math.round(itemColor.g * 255)}, ${Math.round(itemColor.b * 255)}, 0.8)`;
                                }
                            }

                            // Save item color back to rawNodeDataMap for the waterfall
                            if (rawNodeDataMap.has(itemName)) {
                                rawNodeDataMap.get(itemName).baseColor =
                                    itemColor.clone();
                            }

                            // Generation: Leaf Mesh (Tiny Data Node) - Now inheriting true regional Color
                            const iG = new THREE.SphereGeometry(3, 8, 8);
                            const iM = new THREE.MeshBasicMaterial({
                                color: itemColor,
                                transparent: true,
                            });
                            const leafMeshRender = new THREE.Mesh(iG, iM);
                            leafMeshRender.position.copy(itemPos);
                            leafMeshRender.userData.treeId = hub.id;

                            leafMeshRender.userData.name = itemName;
                            leafMeshRender.userData.baseColor =
                                itemColor.clone();
                            scene.add(leafMeshRender);

                            // Generation: Hidden Enlarged Cursor Hitbox - Solving tiny 3D pointer accuracy natively!
                            const hitGeo = new THREE.SphereGeometry(10, 8, 8);
                            const hitMat = new THREE.MeshBasicMaterial({
                                visible: false,
                            });
                            const hitMesh = new THREE.Mesh(hitGeo, hitMat);
                            hitMesh.position.copy(itemPos);
                            hitMesh.userData.hitMesh = true;
                            hitMesh.userData.visibleMesh = leafMeshRender;
                            hitMesh.userData.name = itemName;
                            hitMesh.userData.treeId = hub.id;

                            scene.add(hitMesh);
                            clickableMeshes.push(hitMesh);
                            clickableMeshes.push(leafMeshRender);

                            // Generation: Thick Hierarchical Link directly to Parent (Hub if category is invisible, otherwise Category)
                            if (cat.invisibleCategory) {
                                createThickLine(
                                    hubCenter,
                                    itemPos,
                                    catColor,
                                    1.0,
                                    0.6,
                                    hub.id,
                                    hub.name,
                                    itemName,
                                );
                            } else {
                                createThickLine(
                                    catPos,
                                    itemPos,
                                    catColor,
                                    1.0,
                                    0.6,
                                    hub.id,
                                    cat.name,
                                    itemName,
                                );
                            }

                            // Bind HTML label for the exact Data Item
                            const itemEl = document.createElement("div");
                            itemEl.style.willChange = "transform, opacity";
                            // Completely stripped pointer-events from the massive invisible parent container to block invisible 2D overlapping!
                            itemEl.className =
                                "absolute top-0 left-0 flex flex-col items-center justify-center font-sans tracking-wide select-none pointer-events-none z-30 origin-center";
                            itemEl.style.textShadow = `0px 2px 4px #000, 0px 0px 8px #000, 0px 0px 16px #000, 0px 0px 24px #000, 0px 0px 32px ${cssColor}`;

                            // Main DOM Text Map
                            const primaryNameEl = document.createElement("div");
                            // Injected strict pointer events exclusively directly to the physical Text bounding box!
                            primaryNameEl.className =
                                "text-4xl font-medium text-white text-center pointer-events-auto cursor-pointer";
                            primaryNameEl.innerText = itemName;
                            itemEl.appendChild(primaryNameEl);

                            // Dynamic Pseudo-Layer 4 Annotation Generation!
                            if (typeof item === "object" && item.note) {
                                const noteEl = document.createElement("div");
                                // Render glassmorphism pill container natively mapped with ID tracking for dynamic state visibility!
                                noteEl.className =
                                    "layer-4-note text-lg font-semibold text-white bg-zinc-600/70 backdrop-blur-md border border-white/20 rounded-md px-3 py-1 shadow-2xl leading-tight text-center transition-opacity duration-300 pointer-events-none mt-1 mb-1";
                                noteEl.style.opacity = "0";
                                noteEl.dataset.name = itemName;
                                noteEl.innerText = item.note;

                                // Topographical Mapping Fix: Avoid overlapping the literal physical line!
                                // If the Item's Screen Y is > Category Screen Y, it physically renders ABOVE the category relative to the camera!
                                // This means the line connecting them approaches from the BOTTOM of the Item text. We put the Note ON TOP!
                                if (i2D.y > c2D.y) {
                                    itemEl.insertBefore(noteEl, primaryNameEl);
                                } else {
                                    itemEl.appendChild(noteEl);
                                }
                            }

                            // Bind interaction specifically to the Exact UI String, bypassing invisible bounding planes!
                            bindHTMLClick(
                                primaryNameEl,
                                itemPos,
                                150,
                                itemName,
                            );
                            labelsContainer.appendChild(itemEl);

                            HTML_LABELS.push({
                                element: itemEl,
                                clickTarget: primaryNameEl,
                                position: itemPos,
                                type: "leaf",
                                treeId: hub.id,
                                name: itemName,
                            });

                            globalNodeMap.set(itemName, {
                                position: itemPos,
                                color: itemColor,
                                treeId: hub.id,
                            });
                        });
                    });
                });

                // --- NEW SECONDARY CONNECTIONS PASS ---
                // Draw thin bridge lines across the brain after all positions are mapped
                window.USER_HUBS.forEach((hub) => {
                    hub.categories.forEach((cat) => {
                        // Check Category itself for secondary parents
                        if (
                            typeof cat === "object" &&
                            cat.secondaryParents &&
                            cat.secondaryParents.length > 0
                        ) {
                            const catName = cat.name;
                            const childData = globalNodeMap.get(catName);
                            if (childData) {
                                cat.secondaryParents.forEach((pName) => {
                                    const parentData = globalNodeMap.get(pName);
                                    if (parentData) {
                                        createThickLine(
                                            parentData.position,
                                            childData.position,
                                            parentData.color,
                                            1.2, // slightly thicker for Tier 2 bridges vs Tier 3
                                            0.5,
                                            childData.treeId,
                                            pName,
                                            catName,
                                        );
                                    }
                                });
                            }
                        }

                        // Check Items for secondary parents
                        cat.items.forEach((item) => {
                            if (
                                typeof item === "object" &&
                                item.secondaryParents &&
                                item.secondaryParents.length > 0
                            ) {
                                const itemName =
                                    typeof item === "string" ? item : item.name;
                                const childData = globalNodeMap.get(itemName);
                                if (childData) {
                                    item.secondaryParents.forEach((pName) => {
                                        const parentData =
                                            globalNodeMap.get(pName);
                                        if (parentData) {
                                            // Render thinner cross-connection lines (thickness 0.4 vs main 1.0)
                                            // The line will belong to the child's primary treeId so it fades correctly during Focus mode
                                            createThickLine(
                                                parentData.position,
                                                childData.position,
                                                parentData.color,
                                                0.8,
                                                0.4,
                                                childData.treeId,
                                                pName,
                                                itemName,
                                            );
                                        }
                                    });
                                }
                            }
                        });
                    });
                });
                // --------------------------------------

                // ----------------------------------------------------
                // RENDER LOOP & LOGICC
                // ----------------------------------------------------
                const vProj = new THREE.Vector3();
                let frameCount = 0;
                let flightStartedFrame = 0;
                let lastFrameTime = performance.now();
                const pageLoadTime = performance.now();

                const tempCamDir = new THREE.Vector3();
                const tempPlaneOrigin = new THREE.Vector3();
                const prevCamPos = new THREE.Vector3();
                let wasCameraMovingLastFrame = false;

                function animate() {
                    requestAnimationFrame(animate);

                    const now = performance.now();
                    const deltaSinceLastFrame = now - lastFrameTime;
                    lastFrameTime = now;

                    frameCount++;

                    const camMoved =
                        prevCamPos.distanceToSquared(camera.position) > 0.00001;
                    prevCamPos.copy(camera.position);

                    // FPS & Render Time metrics for performance HUD
                    const rt = Math.round(deltaSinceLastFrame * 10) / 10;
                    if (frameCount % 10 === 0 && showPerfHUD) {
                        const fps = Math.round(1000 / deltaSinceLastFrame);
                        const fpsEl = document.getElementById("hud-fps");
                        const rtEl = document.getElementById("hud-rt");
                        const rtgEl = document.getElementById("hud-rtg");
                        if (fpsEl) fpsEl.innerText = isNaN(fps) ? "0" : fps;
                        if (rtEl) rtEl.innerText = rt;
                        if (rtgEl) rtgEl.innerText = raycastTargets.length;
                    }

                    if (
                        window.startCinematicEntrance === null &&
                        flightStartedFrame === 0
                    ) {
                        flightStartedFrame = frameCount;
                    }

                    if (
                        window.startCinematicEntrance === null &&
                        flightStartedFrame === 0
                    ) {
                        flightStartedFrame = frameCount;
                    }

                    // ----------------------------------------------------
                    // TUNNEL CLIPPING ENGINE: Calculate Foreground "Empty Space"
                    // ----------------------------------------------------
                    if (
                        activeFocusNodeName !== null &&
                        activeFocusNodeName !== "CORE"
                    ) {
                        camera.getWorldDirection(tempCamDir); // Pushes natively OUT into the screen
                        // Plane pushed DEEP into the node structure (50 units BEHIND the target vector node on the Z axis)
                        // Since the focused tree doesn't have clipping planes assigned mathematically, it physically ignores this and stays alive perfectly,
                        // while ALL ambient structures (background lines, outer brain walls) that exist in front of this slice vanish forever!
                        tempPlaneOrigin
                            .copy(targetControlsPos)
                            .addScaledVector(tempCamDir, 50);
                        focusClipPlane.setFromNormalAndCoplanarPoint(
                            tempCamDir,
                            tempPlaneOrigin,
                        );
                    }

                    // Cinematic Click-to-Zoom Flight Integration mathematically synced
                    if (isFlying) {
                        // Time-based calculation ensures animation perfectly syncs regardless of 60Hz or 240Hz monitors
                        const now = performance.now();
                        flightAlpha = Math.min(
                            (now - flightStartTime) / flightDuration,
                            1,
                        );

                        // If flying OUT into the void, use Ease-In (accelerate so it keeps getting smaller).
                        // If flying IN to a node, use Ease-Out (slow down as it approaches).
                        const isFlyingOut =
                            targetCameraPos.length() > startCameraPos.length();
                        const easeAlpha = isFlyingOut
                            ? Math.pow(flightAlpha, 2)
                            : 1 - Math.pow(1 - flightAlpha, 3);

                        if (flightAlpha >= 1) {
                            flightAlpha = 1;
                            isFlying = false;
                        }

                        // Native linear blend between vectors
                        camera.position.lerpVectors(
                            startCameraPos,
                            targetCameraPos,
                            easeAlpha,
                        );
                        controls.target.lerpVectors(
                            startControlsPos,
                            targetControlsPos,
                            easeAlpha,
                        );

                        // OrbitControls math natively recalibrates based on the forcibly shifted camera/target!
                        // This permanently solves the weird "snap bounds" glitch natively since it's executing per frame cleanly.
                        controls.update();
                    } else {
                        controls.update();
                    }

                    // Dynamically scale fog based on camera distance!
                    // This ensures the brain is visible when starting far out (4000)
                    // but still gives that deep "fade to black" depth effect when up close (1500)
                    const camDist = camera.position.length();
                    scene.fog.near = camDist * 0.4;
                    scene.fog.far = camDist * 1.5;

                    // Auto-rotation disabled for now by request.

                    // Iterate through every active label to sync HTML coordinates with WebGL 3D projections!
                    HTML_LABELS.forEach((data, index) => {
                        // FOCUS MODE ENGINE: Calculate absolute Opacity based on localized graph neighborhood
                        // If Core is explicitly focused (meaning we zoomed out cleanly), skip the ghost execution entirely!
                        const isGhosted =
                            activeFocusNodeName !== null &&
                            activeFocusNodeName !== "CORE" &&
                            !window.activeVisibleNodes.has(data.name);
                        const nativeOpacity = isGhosted ? 0.05 : 1.0;

                        // Disable pointer events on ghosted labels to prevent them from intercepting clicks!
                        const targetPointerEvents = isGhosted ? "none" : "auto";
                        const clickEl = data.clickTarget || data.element;
                        if (data.lastPointerEvents !== targetPointerEvents) {
                            clickEl.style.pointerEvents = targetPointerEvents;
                            data.lastPointerEvents = targetPointerEvents;
                        }

                        // Round-robin execution culling for ghosted labels to save CPU layout/render time!
                        // These are shifted to 1/5th update rate (round robin). Since opacity is 0.05, the tiny lag is unnoticeable.
                        if (isGhosted) {
                            if ((frameCount + index) % 5 !== 0) {
                                // Guarantee opacity is set to 0.05 (once) and keep display block
                                if (data.lastOpacity !== "0.05") {
                                    data.element.style.opacity = "0.05";
                                    data.lastOpacity = "0.05";
                                    data.element.style.display = "block";
                                    data.lastDisplay = "block";
                                }
                                return;
                            }
                        }

                        // Natively project the raw 3D Vector to the perspective camera
                        vProj.copy(data.position);
                        vProj.applyMatrix4(brainGroup.matrixWorld); // Account for the ambient rotation!
                        vProj.project(camera);

                        // Project handles hidden elements naturally via z bounds natively if we enforce it:
                        if (vProj.z > 1 || vProj.z < -1) {
                            if (data.lastDisplay !== "none") {
                                data.element.style.display = "none";
                                data.lastDisplay = "none";
                            }
                            return;
                        }

                        const distToCamera = camera.position.distanceTo(
                            data.position,
                        );
                        const fadeBounds = data.type === "hub" ? 1200 : 800; // Text vanishes cleanly if camera zooms away!

                        // Execute HTML overlay opacity math
                        if (distToCamera > fadeBounds) {
                            const transformStr =
                                "translate(-50%, -50%) scale(0)";
                            if (data.lastTransform !== transformStr) {
                                data.element.style.transform = transformStr;
                                data.lastTransform = transformStr;
                            }
                            if (data.lastOpacity !== "0") {
                                data.element.style.opacity = "0";
                                data.lastOpacity = "0";
                            }
                            if (data.lastDisplay !== "none") {
                                data.element.style.display = "none";
                                data.lastDisplay = "none";
                            }
                        } else {
                            if (data.lastDisplay !== "block") {
                                data.element.style.display = "block";
                                data.lastDisplay = "block";
                            }

                            const opacityStr = nativeOpacity.toString();
                            if (data.lastOpacity !== opacityStr) {
                                data.element.style.opacity = opacityStr;
                                data.lastOpacity = opacityStr;
                            }

                            // Native HTML canvas translation centering math
                            const x =
                                Math.round(
                                    (vProj.x * 0.5 + 0.5) *
                                        window.innerWidth *
                                        10,
                                ) / 10;
                            const y =
                                Math.round(
                                    (vProj.y * -0.5 + 0.5) *
                                        window.innerHeight *
                                        10,
                                ) / 10;

                            // Scale effect (closer camera = bigger text)
                            const scaleEffect =
                                Math.round(
                                    Math.max(
                                        0.2,
                                        (fadeBounds - distToCamera) /
                                            fadeBounds,
                                    ) * 100,
                                ) / 100;

                            // Strictly mapping translate(-50%, -50%) to inherently align the text origin-center across the Mesh
                            const transformStr = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%) scale(${scaleEffect})`;
                            if (data.lastTransform !== transformStr) {
                                data.element.style.transform = transformStr;
                                data.lastTransform = transformStr;
                            }
                        }
                    });

                    // Raycast for hover state!
                    // Lazy Raycasting Check: Skip raycast calculations entirely if user is flying, dragging, or camera is rotating due to damping/momentum!
                    const isUserDragging = pointerDownTime !== 0;
                    const isCameraMoving =
                        camMoved || isFlying || isUserDragging;

                    const cameraJustStopped =
                        !isCameraMoving && wasCameraMovingLastFrame;
                    wasCameraMovingLastFrame = isCameraMoving;

                    if (isCameraMoving) {
                        hoveredObj = null;
                        setBodyCursor(isUserDragging ? "grabbing" : "default");
                        hoverRing.visible = false;
                    } else if (mouseMoved || cameraJustStopped) {
                        raycaster.setFromCamera(hoverMouse, camera);
                        const hoverIntersects = raycaster
                            .intersectObjects(raycastTargets)
                            .filter((hit) => isValidTarget(hit.object));

                        if (hoverIntersects.length > 0) {
                            hoveredObj = hoverIntersects[0].object;
                            if (
                                hoveredObj.userData.name ||
                                hoveredObj.userData.endpoints
                            ) {
                                setBodyCursor("pointer");
                            } else {
                                setBodyCursor("default");
                            }

                            // Activate Node Halo Ring natively
                            if (hoveredObj.userData.name) {
                                hoverRing.visible = true;
                                const targetMeshRef =
                                    hoveredObj.userData.visibleMesh ||
                                    hoveredObj;
                                hoverRing.position.copy(targetMeshRef.position);
                                // Set ring size perfectly to boundary of the sphere geometry
                                const r =
                                    targetMeshRef.geometry.parameters.radius ||
                                    3;
                                hoverRing.scale.setScalar(r);
                                hoverRing.lookAt(camera.position);
                            } else {
                                hoverRing.visible = false;
                            }
                        } else {
                            hoveredObj = null;
                            setBodyCursor("default");
                            hoverRing.visible = false;
                        }
                    }

                    mouseMoved = false;

                    // Opacity Engine for literal 3D Meshes (Nodes, Biological Ambient Structures, and Thick Core Lines!)
                    clickableMeshes.forEach((mesh) => {
                        if (mesh.userData.hitMesh) return; // Skip invisible hitboxes in rendering math!

                        // If the user zoomed out cleanly to the core (entire brain view), NOTHING should be ghosted!
                        let isGhostedMesh =
                            activeFocusNodeName !== null &&
                            activeFocusNodeName !== "CORE";

                        // If something specific is focused, only ghost it if it explicitly does NOT belong to the active neighborhood!
                        if (isGhostedMesh) {
                            if (mesh.userData.name) {
                                isGhostedMesh = !window.activeVisibleNodes.has(
                                    mesh.userData.name,
                                );
                            } else if (mesh.userData.endpoints) {
                                isGhostedMesh = !(
                                    window.activeVisibleNodes.has(
                                        mesh.userData.endpoints[0],
                                    ) &&
                                    window.activeVisibleNodes.has(
                                        mesh.userData.endpoints[1],
                                    )
                                );
                            } else if (mesh.userData.isAmbient) {
                                // For Ambient Biological layers, they ghost inherently if *any* local node is active!
                                isGhostedMesh = true;
                            } else {
                                // Fallback (e.g. unknown node), ghost it
                                isGhostedMesh = true;
                            }
                        }

                        const isHovered =
                            hoveredObj === mesh ||
                            (hoveredObj &&
                                hoveredObj.userData.visibleMesh === mesh);

                        // We map original ambient opacities manually since they were specifically faint
                        // Base opacity is 0.5 for ambient nodes/dots, 0.25 for webbing lines, 1.0 for solid models
                        let baseTargetOpacity = 1.0;
                        if (mesh.userData.isAmbient) {
                            baseTargetOpacity =
                                mesh instanceof THREE.Points ? 0.5 : 0.25;
                        } else if (mesh.userData.endpoints) {
                            baseTargetOpacity =
                                mesh.userData.baseOpacity || 0.6;
                        }

                        const targetOpacity =
                            isHovered &&
                            !isGhostedMesh &&
                            mesh.userData.endpoints
                                ? 1.0
                                : isGhostedMesh
                                  ? 0.05
                                  : baseTargetOpacity;

                        // Check if opacity changed to avoid redundant uniform uploads
                        if (mesh.userData.lastOpacity !== targetOpacity) {
                            mesh.material.opacity = targetOpacity;
                            mesh.userData.lastOpacity = targetOpacity;
                        }

                        // Check if color changed to avoid redundant uniform uploads
                        const isColorHovered = !!(
                            isHovered &&
                            !isGhostedMesh &&
                            mesh.userData.endpoints
                        );
                        if (mesh.userData.lastColorHovered !== isColorHovered) {
                            if (isColorHovered) {
                                mesh.material.color
                                    .copy(mesh.userData.baseColor)
                                    .lerp(new THREE.Color(0xffffff), 0.6);
                            } else {
                                if (mesh.userData.baseColor) {
                                    mesh.material.color.copy(
                                        mesh.userData.baseColor,
                                    );
                                }
                            }
                            mesh.userData.lastColorHovered = isColorHovered;
                        }

                        // If this is a biological array blocking the camera and we are focused on a tree, literally slice it transparent!
                        const wantsClipping = !!(
                            isGhostedMesh && mesh.userData.isAmbient
                        );
                        if (mesh.userData.lastClipping !== wantsClipping) {
                            mesh.material.clippingPlanes = wantsClipping
                                ? [focusClipPlane]
                                : [];
                            mesh.userData.lastClipping = wantsClipping;
                        }
                    });

                    // Faint down the Outer GLTF Biological Shell and slice it!
                    if (window.brainModelRef) {
                        const isGhostedShell =
                            activeFocusNodeName !== null &&
                            activeFocusNodeName !== "CORE";
                        if (window.lastGhostedShellState !== isGhostedShell) {
                            window.brainModelRef.traverse((child) => {
                                if (child.isMesh) {
                                    const nativeTarget = child.material
                                        .wireframe
                                        ? 0.03
                                        : 0.06;
                                    child.material.opacity = isGhostedShell
                                        ? 0.01
                                        : nativeTarget;
                                    child.material.clippingPlanes =
                                        isGhostedShell ? [focusClipPlane] : [];
                                }
                            });
                            window.lastGhostedShellState = isGhostedShell;
                        }
                    }

                    renderer.render(scene, camera);
                }

                // Window resize binding
                window.addEventListener("resize", () => {
                    camera.aspect = window.innerWidth / window.innerHeight;
                    camera.updateProjectionMatrix();
                    renderer.setSize(window.innerWidth, window.innerHeight);
                });

                // Start WebGL
                rebuildRaycastTargets(); // Initial Partitioning Build!
                animate();

                // Cinematic Entrance (Triggered by GLTFLoader!)
                window.startCinematicEntrance = function () {
                    const overlay = document.getElementById(
                        "brain-entrance-overlay",
                    );
                    if (overlay) overlay.style.opacity = "0";

                    // Fly in slowly from the deep void (10000) to the standard resting distance (1500)
                    // Duration of 2700ms guarantees it outlasts the 1.0s overlay fade!
                    flyTo(new THREE.Vector3(0, 0, 0), 1500, "CORE", 2700);
                };

                // Fallback Timeout: If GLTF utterly fails or network hangs for 5 seconds, start anyway so user isn't permanently trapped!
                setTimeout(() => {
                    if (window.startCinematicEntrance) {
                        console.warn(
                            "GLTFLoader took too long, fallback triggering entrance.",
                        );
                        window.startCinematicEntrance();
                        window.startCinematicEntrance = null;
                    }
                }, 5000);
                // ----------------------------------------------------
                // PERFORMANCE HUD MONITOR INITIALIZATION
                // ----------------------------------------------------
                let showPerfHUD = false;
                const hudContainer = document.createElement("div");
                hudContainer.id = "perf-hud";
                hudContainer.className =
                    "fixed bottom-6 right-6 z-[99] hidden font-mono text-xs text-emerald-400 bg-zinc-950/90 backdrop-blur-md border border-emerald-500/30 rounded-md px-3 py-2.5 leading-relaxed shadow-2xl pointer-events-none";
                hudContainer.innerHTML = `
                    <div style="font-weight: bold; border-bottom: 1px solid rgba(16,185,129,0.3); margin-bottom: 6px; padding-bottom: 4px;">PERFORMANCE MONITOR</div>
                    <div>FPS: <span id="hud-fps" style="font-weight: bold; color: #fff;">0</span></div>
                    <div>Frame time: <span id="hud-rt" style="font-weight: bold; color: #fff;">0</span> ms</div>
                    <div>Raycast targets: <span id="hud-rtg" style="font-weight: bold; color: #fff;">0</span></div>
                `;
                document.body.appendChild(hudContainer);

                window.addEventListener("keydown", (e) => {
                    if (e.key.toLowerCase() === "p") {
                        showPerfHUD = !showPerfHUD;
                        if (showPerfHUD) {
                            hudContainer.classList.remove("hidden");
                        } else {
                            hudContainer.classList.add("hidden");
                        }
                    }
                });
            } catch (error) {
                // FATAL ERROR CATCHER FOR DEBUGGING
                const errDiv = document.createElement("div");
                errDiv.style.position = "fixed";
                errDiv.style.top = "100px";
                errDiv.style.left = "50px";
                errDiv.style.color = "red";
                errDiv.style.zIndex = "9999";
                errDiv.style.fontFamily = "monospace";
                errDiv.innerText =
                    "CRASH: " + error.toString() + "\n" + error.stack;
                document.body.appendChild(errDiv);
            }
        </script>
    </body>
</html>
